##########################################################################################################################################
# This is an application descriptor for joomla. Using this technique you can provide customisations to how you install joomla.
# Here you will find various details required for the successful installation of joomla ss such as the database credentials for your joomla 
# install and details required by the application itself such as a username and password. Unless your adt-build-machine-scripts repository 
# is private please be aware not to put any sensitive information directly in this file, instead, look at how the MANDATORY_INDIVIDUAL_SETTING 
# parameters are used in a way that keeps the senstive details private in all circumstances using placeholders which can be substituted out. 
##########################################################################################################################################

#################################################################################################################################################
# Application credentials/descriptions (if you make an interactive installation these settings will be overridden by what you enter interactively)
#################################################################################################################################################

#The description of your website as it will appear on your webpage
WEBSITE_NAME:Vanilla Joomla Website

#You most likely want to set this to something unique because setting it to something unique is another thing that a hacker doesn't know 
# where as if it's just webmaster or admin that's easier to guess or assume
WEBSITE_USERNAME:adt-webmaster

#The initial website password (which you should change as soon as installation is complete) is taken from whatever the first 12 characters of your
#S3_ACCESS_KEY variable is set to. So, to find the initial password for your application you need to find  your S3_ACCESS_KEY and extract the first
#12 characters of it as your bootstrap password
WEBSITE_PASSWORD:XXXXWEBSITE_PASSWORDXXXX

#A decription of the website user account
WEBSITE_USER_DESCRIPTION:ADT Test User Account

############################################################################################
#This is taken from the value of "SYSTEM_FROM_EMAIL_ADDRESS" and it needs to be a live email. 
############################################################################################
WEBMASTER_EMAIL:XXXXWEBMASTER_EMAILXXXX

##########################################################################################################################################
# joomla version and URL to download joomla sourcecode from (uncomment or modify according to which version of joomla you want to install)
##########################################################################################################################################
#Sourced from github
#SOURCECODE_URL:github.com/joomla/joomla-cms/releases/download/XXXXAPPLICATION_VERSIONXXXX/Joomla_XXXXAPPLICATION_VERSIONXXXX-Alpha-Full_Package.zip
#SOURCECODE_URL:github.com/joomla/joomla-cms/releases/download/XXXXAPPLICATION_VERSIONXXXX/Joomla_XXXXAPPLICATION_VERSIONXXXX-Beta-Full_Package.zip
#SOURCECODE_URL:github.com/joomla/joomla-cms/releases/download/XXXXAPPLICATION_VERSIONXXXX/Joomla_XXXXAPPLICATION_VERSIONXXXX-Release_Candidate-Full_Package.zip
#SOURCECODE_URL:github.com/joomla/joomla-cms/releases/download/XXXXAPPLICATION_VERSIONXXXX/Joomla_XXXXAPPLICATION_VERSIONXXXX-Stable-Full_Package.zip

#Sourced from joomla.org using zip archives
SOURCECODE_URL:downloads.joomla.org/cms/joomla6/6-0-3/Joomla_6-0-3-Stable-Full_Package.zip
SOURCECODE_MD5:a3eaae4a62d2313de01d7ff7ba5417e9
SOURCECODE_SHA1:5ab47253f669a86e8002e524d8218dfbd79bf88e

#Sourced from joomla.org using tar archives
#SOURCECODE_URL:downloads.joomla.org/cms/joomla6/6-0-3/Joomla_6-0-3-Stable-Full_Package.tar.gz
#SOURCECODE_MD5:d306e61affe62b37245ffddad1361a4f
#SOURCECODE_SHA1:df41236826fdcaa889c5ee3f9bc35ed94114ee0a

#Example quickstart package from joomshaper which may or may not be a live url by the time you read this it works at the current time
#SOURCECODE_URL:www.joomshaper.com/downloads/template/helix3/1-quickstart-pack-joomla-6

####################################################################################################################################
#This tells the system which files or directories to exclude when a backup or baseline is made. Anything that contains sensitive information
#from within your webroot can be excluded from the backup or baseline here. Note: this file will be a symlink by default and the backup
#process won't archive symlinks but having the configuration file listed here makes us double sure that it won't appear inadvertently in a 
#baseline or a backup and leak senstive information about our infrastructure
####################################################################################################################################
EXCLUDE_FROM_BACKUP:configuration.php:administrator/cache

#####################################################################################################################################################
#These settings pick various directories and files which should be present in a joomla installation. What that means is that if there is a partial
#download or extraction of joomla and some files are missing by using these files to check the intergrity of the installtion we can detect this
#and make a notification. Note: if the CMS releases a new version its possible that the webroot directory structure might have altered and in this case
#an installation of the new version will fail its integrity checks. This list of files needs to be updated to reflect the revised directory structure
#in order for the verification process to succeed fully. I check for quite a lot of different directories or files if you want to make it a less stringent
#check you can check for more or less files and directories according to your taste. 
######################################################################################################################################################
APPLICATION_INTEGRITY_DIRECTORIES:administrator:api:cli:components:files:includes:language:layouts:libraries:media:modules:plugins:templates
APPLICATION_INTEGRITY_FILES:index.php

######################################################################################################################################################
#This sets the webroot of your application. You can change this and the webroot will install under a different subdirectory
######################################################################################################################################################
WEBROOT_DIRECTORY:/var/www/html/joomla

########################################################################################################################################################
#This is where the joomla configuration file is actually located (outside of the webroot) which makes backup processes easier as well as enhancing
#the security of our systems. Behind the scenes this is what is happening to make this configuration file accessible to the main CMS
# /bin/ls -s /var/www/outside_webroot/configuration.php ${webroot_directory}/configuration.php
######################################################################################################################################################
CONFIG_FILE:/var/www/outside_webroot/configuration.php

#########################################################################################################################
#The assets for your CMS are to be located outside of your webroot. This means makes it easy to give them different access
#permissions to the rest of the application as they are to be dynamically updatable at all times and you might therefore
#want to use a different permission set. 
#ASSETS_DIRECTORIES_TO_LINK links a subdirectory of the webroot to the actual assets directory outside of the webroot. You can provide
#a colon separated list of asset directories that you want to be linked to actual assets directories outside of your webroot for example:
#ASSETS_DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/images/members|/var/www/outside_webroot/images/members:XXXXWEBROOT_DIRECTORYXXXX/images/system|/var/www/outside_webroot/images/user/system
#You aren't only limied to linking assets directories outside of your webroot you can also link regular directories using DIRECTORIES_TO_LINK
#WEBROOT_ASSET_DIRECTORIES must be a one to one correlation with ASSETS_DIRECTORIES_TO_LINK
#These links aren't actioned for virgin or baseline builds all the asset files are of a baseline or a virgin build are directly under the webroot
#without any symlinks to directories outside of the webroot
######################################################################################################################################################
WEBROOT_ASSET_DIRECTORIES:images
ASSETS_DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/images|/var/www/outside_webroot/images
DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/administrator/cache|/var/www/outside_webroot/administrator/cache:XXXXWEBROOT_DIRECTORYXXXX/tmp|/var/www/outside_webroot/tmp:XXXXWEBROOT_DIRECTORYXXXX/logs|/var/www/outside_webroot/logs:XXXXWEBROOT_DIRECTORYXXXX/cache|/var/www/outside_webroot/cache

######################################################################################################################################################
#These are directories which you want to be ourside or your webroot but not to be linked to. If you want directories outside of your webroot
#that are to be symlinked to  you should use DIRECTORIES_TO_LINK. And so the directories I show you here are accessed by configuring:
#INDIVIDUAL_SETTINGlog_path='/var/www/outside_webroot/logs'
#INDIVIDUAL_SETTING:tmp_path='/var/www/outside_webroot/tmp'
#INDIVIDUAL_SETTING:cache_path='/var/www/outside_webroot/cache'
#which will set these as live values in the configuration.php file. So, "/var/www/outside_webroot/logs" in configuration.php maps to "logs" lited here
######################################################################################################################################################
#DIRECTORIES_OUTSIDE_WEBROOT:cache:logs:tmp

#####################################################################################################################################################
#Interactive install or not
#If this is set to "yes" then during installation the build will pause until you navigate to your website and enter database credentials and so on.
#In interactive mode, the database credentials, database identifier and port are displayed as part of the build logging output and you can find out
#what they are in ${BUILD_HOME}/runtime/${CLOUDHOST}/${BUILD_IDENTIFIER}/logs
#If this is set to "no" then the installtion should complete without pausing and you will be able to access your joomla application straight away
#without providing any dynamic input at build time
#####################################################################################################################################################
INTERACTIVE_APPLICATION_INSTALL:no

##################################################################################################################################################
#Here you can list PHP modules that are required by joomla and the system will install them. You can alter the configuration of your PHP setup by
#tweaking these values and the system will tweak your PHP configuration. I am not an expert in tuning PHP so you may well want to alter these settings
#to fit your particular use case for optimal performance and security and so on. 
##################################################################################################################################################
PHP_MODULES:apcu:xml:dom:gd:intl:zip:mysqli:pdo:pgsql:mbstring:curl:soap
CONFIG_PHP_INI:memory_limit=128M:file_uploads=On:session.save_handler=files:session.save_path=/var/run/session:upload_max_filesize=64M:post_max_size=64M:max_input_vars=5000:zlib.output_compression=On:cgi.fix_pathinfo=0:output_buffering=Off:disable_functions=exec,passthru,shell_exec,system,popen,parse_ini_file,show_source:allow_url_fopen=Off:allow_url_include=Off:memory_limit=256M:opcache.enable=1:opcache.memory_consumption=256:open_basedir=/var/log##/var/run##/var/cache##/var/www/html##/var/www/outside_webroot:upload_tmp_dir=/var/www/outside_webroot/tmp:sys_temp_dir=/var/www/outside_webroot/tmp:expose_php=Off:date.timezone='Europe/London':cgi.force_redirect=On   
CONFIG_PHP_POOL:pm=ondemand:pm.max_children=10:pm.max_requests=200:pm.start_servers=10:pm.min_spare_servers=5:pm.max_spare_servers=20:pm.process_idle_timeout=10s

#####################################################################################################################################################
# Mandatory credential settings when making a non-interactive installation. If an interactive installation is made, these values will be ignored
#These are mandatory database settings that are absolutely required for there to be any chance of your application coming online if you are installing
#joomla non-interactively. Notice that placeholders are used and are populated privately with live data in the script
# ${BUILD_HOME}/application/joomla/SetApplicationConfig.sh
#####################################################################################################################################################
MANDATORY_INDIVIDUAL_SETTING:user='XXXXAPPLICATION_USERNAMEXXXX'
MANDATORY_INDIVIDUAL_SETTING:password='XXXXAPPLICATION_PASSWORDXXXX'
MANDATORY_INDIVIDUAL_SETTING:db='XXXXAPPLICATION_DATABASEXXXX'

#########################################################################################################################################################
# General individual settings for your joomla install
#These settings are general configuration settings for joomla. You can set various behaviours using these settings. In a live situation you could have
#a set of configuration files such as /var/www/html/configuration.php or /var/www/html/configuration-debug.php and you can switch from one configuration
#to another (if you want to debug for example you can switch to your debug configuration) simply by holding multiple configuration files ourside of your
#webroot and linking  to one rather than the other to change how your application is behaving
#########################################################################################################################################################
INDIVIDUAL_SETTING:mailer='smtp'
INDIVIDUAL_SETTING:smtpauth=1
INDIVIDUAL_SETTING:smtpuser='XXXXSMTP_USERXXXX'
INDIVIDUAL_SETTING:smtppass='XXXXSMTP_PASSXXXX'
INDIVIDUAL_SETTING:smtpsecure='tls'
INDIVIDUAL_SETTING:smtpport=XXXXSMTP_PORTXXXX
INDIVIDUAL_SETTING:smtphost=XXXXSMTP_HOSTXXXX

##########################################################################################################################################################
#Hardcoded overrides (you can override any default setting in the configuration.php file for joomla by setting it here as per the examples)
#Each of these settings map directly to an actual setting in the configuration.php file and obviously needs to be syntactically identical to whatever is in 
#the configuration.php file for that setting. 
#This example, switches on SEF, for example, but you can override any of the default settings here
###########################################################################################################################################################
INDIVIDUAL_SETTING:cachetime=30
INDIVIDUAL_SETTING:cache_handler='file'
INDIVIDUAL_SETTING:caching=1
INDIVIDUAL_SETTING:sef=1
INDIVIDUAL_SETTING:sef_suffix=1
INDIVIDUAL_SETTING:sef_rewrite=1
INDIVIDUAL_SETTING:unicodeslugs=1
INDIVIDUAL_SETTING:gzip=1
INDIVIDUAL_SETTING:force_ssl=2
INDIVIDUAL_SETTING:shared_session=0
INDIVIDUAL_SETTING:log_path='XXXXWEBROOT_DIRECTORYXXXX/logs'
INDIVIDUAL_SETTING:tmp_path='XXXXWEBROOT_DIRECTORYXXXX/tmp'
INDIVIDUAL_SETTING:cache_path='XXXXWEBROOT_DIRECTORYXXXX/cache'
