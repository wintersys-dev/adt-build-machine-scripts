##########################################################################################################################################
# This is an application descriptor for moodle. Using this technique you can provide customisations to how you install moodle.
# Here you will find various details required for the successful installation of moodle such as the database credentials for your moodle
# install and details required by the application itself such as a username and password. Unless your adt-build-machine-scripts repository 
# is private please be aware not to put any sensitive information directly in this file, instead, look at how the MANDATORY_INDIVIDUAL_SETTING 
# parameters are used in a way that keeps the senstive details private in all circumstances using placeholders which can be substituted out. 
##########################################################################################################################################

#################################################################################################################################################
# Application credentials/descriptions (if you make an interactive installation these settings will be overridden by what you enter interactively)
#################################################################################################################################################
#You most likely want to set this to something unique because setting it to unique is another thing that a hacker doesn't know where as if it's
#just webmaster or admin that's easy to guess or assume
WEBSITE_USERNAME:adt-webmaster

##################################################################################################################################################
#The initial website password (which you should change as soon as installation is complete) is taken from whatever the first 12 characters of your
#S3_ACCESS_KEY variable is set to. So, to find the initial password for your application you need to find  your S3_ACCESS_KEY and extract the first
#12 characters of it s your bootstrap password
##################################################################################################################################################
WEBSITE_PASSWORD:XXXXWEBSITE_PASSWORDXXXX

WEBSITE_FULLNAME:Vanilla Moodle Website
WEBSITE_SHORTNAME:Vanilla Moodle

#####################################################################################################################################################
#This is taken from the value of "SYSTEM_FROM_EMAIL_ADDRESS" and it needs to be a live email.
#####################################################################################################################################################
WEBMASTER_EMAIL:XXXXWEBMASTER_EMAILXXXX

##########################################################################################################################################
# moodle version and URL to download moodle sourcecode from (uncomment or modify according to which version of moodle you want to install)
##########################################################################################################################################
#To install from a git branch, use this
MOODLE:git-branch:MOODLE_502_STABLE

#To install from downloadable archives, use one of these sets
#SOURCECODE_URL:download.moodle.org/download.php/direct/stable502/moodle-5.2.2.tgz
#SOURCECODE_MD5:6bea4b4540982d4a3a86abc2faadeeca
#SOURCECODE_SHA256:72be209e7c0f5341b87de0bc993b2430087fda2769d8c3cc2f32736d1513e88c

#SOURCECODE_URL:download.moodle.org/download.php/direct/stable502/moodle-5.2.2.zip
#SOURCECODE_MD5:bacd011fc5427486a0c69a5eb42843aa
#SOURCECODE_SHA256:4ebd1be6116458672f94c66563fdead8979ffff8573ae0a645b4a625d5c64b70

###############################################################################
#A list of any libraries that need to be installed for your application to work
###############################################################################
REQUIRED_SOFTWARE_LIBRARIES:

####################################################################################################################################
#filesystem configuration settings
#This will create a logging directory a temporary directory and a caching directory outside of the weboot for increased security
#If you install a filesystem cache plugin at any point then you can use this caching directory to store your cached files/assets by 
#configuring it in the plugin
####################################################################################################################################
#DIRECTORIES_TO_CREATE:logs:tmp:cache:moodledata


#####################################################################################################################################################
#These settings pick various directories and files which should be present in a moodle installation. What that means is that if there is a partial
#download or extraction of moodle and some files are missing by using these files to check the intergrity of the installtion we can detect this
#and make a notification
######################################################################################################################################################
APPLICATION_INTEGRITY_DIRECTORIES:lib:admin:public/admin:public/ai:public/analytics:public/auth:public/availability:public/backup:public/badges:public/blocks:public/blog:public/cache:public/calendar:public/cohort:public/comment:public/communication:public/competency:public/completion:public/contentbank:public/course:public/customfield:public/dataformat:public/enrol:public/error:public/favourites:public/files:public/filter:public/grade:public/group:public/h5p:public/install:public/iplookup:public/lang:public/lib:public/local:public/login:public/media:public/message:public/mnet:public/mod:public/my:public/notes:public/payment:public/pix:public/plagiarism:public/portfolio:public/privacy:public/question:public/rating:public/report:public/reportbuilder:public/repository:public/rss:public/search:public/sms:public/tag:public/theme:public/user:public/userpix:public/webservice
APPLICATION_INTEGRITY_FILES:admin/cli/install.php:public/behat.yml.dist:public/brokenfile.php:public/draftfile.php:public/editmode.php:public/file.php:public/help.php:public/help_ajax.php:public/index.php:public/install.php:public/pluginfile.php:public/r.php:public/security.txt:public/tokenpluginfile.php:public/version.php

######################################################################################################################################################
#This sets the webroot of your application. You can change this according to your taste. 
######################################################################################################################################################
WEBROOT_DIRECTORY:/var/www/html/moodle
WEBROOT_SUBDIRECTORY:public


#########################################################################################################################
#These next three settings only operate when you deploy in production mode from a temporal backup. They are ignored if you 
# are deploying from a baseline or making a virgin installation
########################################################################################################################

########################################################################################################################
# WEBROOT_ASSET_DIRECTORIES lists the directories that you want to mount S3 buckets to for increased capacity.
# Each entry in the : separated list is a different bucket. So, you could, have two buckets mounted into your webroot
# by setting: WEBROOT_ASSET_DIRECTORIES:images/users:images/system
# You need to be mindful that if these directories are in your webroot they will be included in any backup you make so you certainly
# don't want many  GB or more of assets in your backup achive so you need to include these directories in your list of directories
# to exclude from your backup which you can do by setting for the examples given:
# EXCLUDE_FROM_BACKUP:joomla/images  or EXCLUDE_FROM_BACKUP:joomla/images/users:joomla/images/system
# If you configure your webroot assets to be outside of your webroot they won't be stored in your backup because symlinks are ignored by
# the backup process that runs against your webroot but its still recommended that you add them to your EXCLUDE_FROM_BACKUP: configuration
# to give you doube protection 
#########################################################################################################################
WEBROOT_ASSET_DIRECTORIES:moodledata

##############################################################################################################################
#If you want your assets to be outside of your webroot because that can be easier to manage as for example you might want your
#webroot to be immutable but your assets directory to be mutable (in other words users can generate files there) then you can 
#simply set ASSETS_DIRECTORIES_TO_LINK: and that will create a symlink to your assets directory outside of your webroot
#and so in the example given above that might look like:
# ASSETS_DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/images/users|/var/www/outside_webroot/images/users:XXXXWEBROOT_DIRECTORYXXXX/images/system|/var/www/outside_webroot/images/system
###############################################################################################################################
ASSETS_DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/moodledata|/var/www/outside_webroot/moodledata

###################################################################################################################################
# This option enables you to link system directories and so on to outside your webroot which makes it easier to manage because you 
# don't want log files and so on in your baselines and backups and the backup process ignores symlinks and so doesn't archive them
# and so if you want to have a logging directory accessible from within the webroot but linked to a directory outside of the webroot
# then you can define a logging directory thus:
# DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/logging|/var/www/outside_webroot/logging
# and the system will action the same thing as ln -s /var/www/outside_webroot/logging XXXXWEBROOT_DIRECTORYXXXX/logging
####################################################################################################################################
DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/tmp|/var/www/outside_webroot/tmp:XXXXWEBROOT_DIRECTORYXXXX/logs|/var/www/outside_webroot/logs:XXXXWEBROOT_DIRECTORYXXXX/cache|/var/www/outside_webroot/cache

####################################################################################################################################
#This tells the system which files or directories to exclude when a backup or baseline is made. Anything that contains sensitive information
#from within your webroot can be excluded from the backup or baseline here. 
####################################################################################################################################
EXCLUDE_FROM_BACKUP:moodle/config.php:moodle/moodledata

########################################################################################################################################################
#This sets the moodle config file to be outside of the webroot. 
######################################################################################################################################################
CONFIG_FILE:/var/www/html/config.php


###########################################################################################
#Here you can list PHP modules that are required by moodle and the system will install them 
###########################################################################################
#PHP_VERSION:8.5
PHP_MODULES:apcu:ctype:curl:dom:gd:iconv:intl:mbstring:mysqli:openssl:pcre:pdo:pgsql:xml:soap:xml:xmlreader:zip
CONFIG_PHP_INI:memory_limit=128M:file_uploads=On:session.save_handler=files:session.save_path=/var/run/session:upload_max_filesize=64M:post_max_size=64M:max_input_vars=5000:zlib.output_compression=Off:cgi.fix_pathinfo=1:output_buffering=Off:disable_functions=exec,passthru,shell_exec,system,popen,parse_ini_file,show_source:allow_url_fopen=Off:allow_url_include=Off:memory_limit=256M:opcache.enable=1:opcache.memory_consumption=256:open_basedir=/var/log##/var/run##/var/cache##/var/www/html##/var/www/outside_webroot:upload_tmp_dir=/var/www/html/tmp:sys_temp_dir=/var/www/html/tmp:expose_php=Off:date.timezone='Europe/London':cgi.force_redirect=On   
CONFIG_PHP_POOL:pm=ondemand:pm.max_children=10:pm.max_requests=200:pm.start_servers=10:pm.min_spare_servers=5:pm.max_spare_servers=20:pm.process_idle_timeout=10s

#####################################################################################################################################################
#Interactive install or not
#If this is set to "yes" then during installation the build will pause until you navigate to your website and enter database credentials and so on.
#In interactive mode, the database credentials, database identifier and port are displayed as part of the build logging output and you can find out
#what they are in ${BUILD_HOME}/runtime/${CLOUDHOST}/${BUILD_IDENTIFIER}/logs
#If this is set to "no" then the installtion should complete without pausing and you will be able to access your moodle application straight away
#without providing any input
#####################################################################################################################################################
INTERACTIVE_APPLICATION_INSTALL:no

#####################################################################################################################################################
# Mandatory credential settings when making a non-interactive installation
#These are mandatory database settings that are absolutely required for there to be any chance of your application coming online if you are installing
#moodle non-interactively. Notice that placeholders are used and are populated privately with live data in the script
# ${BUILD_HOME}/application/moodle/SetApplicationConfig.sh
#####################################################################################################################################################
MANDATORY_INDIVIDUAL_SETTING:dbuser=XXXXAPPLICATION_USERNAMEXXXX
MANDATORY_INDIVIDUAL_SETTING:dbpass=XXXXAPPLICATION_PASSWORDXXXX
MANDATORY_INDIVIDUAL_SETTING:dbname=XXXXAPPLICATION_DATABASEXXXX
