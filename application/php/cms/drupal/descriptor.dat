##########################################################################################################################################
# This is an application descriptor for drupal. Using this technique you can provide customisations to how you install drupal.
# Here you will find various details required for the successful installation of drupal such as the database credentials for your drupal
# install and details required by the application itself such as a username and password. Unless your adt-build-machine-scripts repository 
# is private please be aware not to put any sensitive information directly in this file, instead, look at how the MANDATORY_INDIVIDUAL_SETTING 
# parameters are used in a way that keeps the senstive details private in all circumstances using placeholders which can be substituted out. 
##########################################################################################################################################

#The description of your website as it will appear on your webpage
WEBSITE_NAME:Vanilla Drupal Website

#################################################################################################################################################
# Application credentials/descriptions (if you make an interactive installation these settings will be overridden by what you enter interactively)
#################################################################################################################################################
#You most likely want to set this to something unique because setting it to unique is another thing that a hacker doesn't know where as if it's
#just webmaster or admin that's easy to guess or assume
WEBSITE_USERNAME:adt-webmaster

#The initial website password (which you should change as soon as installation is complete) is taken from whatever the first 12 characters of your
#S3_ACCESS_KEY variable is set to. So, to find the initial password for your application you need to find  your S3_ACCESS_KEY and extract the first
#12 characters of it s your bootstrap password
WEBSITE_PASSWORD:XXXXWEBSITE_PASSWORDXXXX

###################################################################
#Application Type (only uncomment one of these 2 depending on whether you want to install "drupal" or "drupal cms")
###################################################################

#-----------------------------------DRUPAL-------------------------------------------------
#****MAKE SURE ALL THE DRUPAL CMS OPTIONS BELOW ARE COMMENTED OUT OR THINGS WILL FAIL*****#
#------------------------------------------------------------------------------------------
# 1. To install drupal uncomment as required
APPLICATION_TYPE:drupal

#(pick which version of drupal you want to install by uncommenting one of these)
DRUPAL_VERSION:drupal/recommended-project
#DRUPAL_VERSION:drupal/recommended-project:11.4.3
#DRUPAL_VERSION:drupal/recommended-project:^11@alpha
#DRUPAL_VERSION:drupal/recommended-project:^11@beta
#DRUPAL_VERSION:drupal/recommended-project:^11@rc

#Install themes or modules during the build rather than through the gui. 
#You can chain themes to install as a list DRUPAL_MODULES_TO_INSTALL:<module1> <module2> <module3>....<module n>
#You can chain modules to install as a list DRUPAL_MODULES_TO_INSTALL:<module1> <module2> <module3>....<module n>
#Only activate one of these examples at a time or configure your own according to you needs
#Example 1 - install the tara theme (https://www.drupal.org/project/tara)
#DRUPAL_THEMES_TO_INSTALL:tara:^11.0
#Example 2 - install the mercury theme (https://www.drupal.org/project/mercury)
#DRUPAL_THEMES_TO_INSTALL:mercury:^1.0
#DRUPAL_MODULES_TO_INSTALL:cva:^1.0
#Example 3 - install the bootstrap theme (https://www.drupal.org/project/bootstrap)
DRUPAL_THEMES_TO_INSTALL:bootstrap:^3.40
DRUPAL_MODULES_TO_INSTALL:jquery_ui:^1.8 jquery_ui_draggable:^2.1 jquery_ui_resizable:^2.1

######################################################################################################################################################
#This sets the webroot of your application. For drupal this shouldn't be changed for the application to work properly
######################################################################################################################################################
WEBROOT_DIRECTORY:/var/www/html/drupal
WEBROOT_SUBDIRECTORY:web

####################################################################################################################################
#This tells the system which files to exclude when a backup or baseline is made
####################################################################################################################################
EXCLUDE_FROM_BACKUP:drupal/web/sites/default/settings.php

#############################DRUPAL##############################################

#-----------------------------------DRUPAL CMS-----------------------------------------
#****MAKE SURE ALL THE DRUPAL OPTIONS ABOVE ARE COMMENTED OUT OR THINGS WILL FAIL*****#
#--------------------------------------------------------------------------------------
#2. To install drupal CMS
#APPLICATION_TYPE:cms

#(pick which version of drupal cms you want to install by uncommenting one of these)
#CMS_VERSION:drupal/cms
#CMS_VERSION:drupal/cms:2.1.3
#CMS_VERSION:drupal/cms:^2.1@alpha
#CMS_VERSION:drupal/cms:^2.1@beta
#CMS_VERSION:drupal/cms:^2.1@rc

#Install themes or modules during the build rather than through the gui. 
#You can chain themes to install as a list DRUPAL_MODULES_TO_INSTALL:<module1> <module2> <module3>....<module n>
#You can chain modules to install as a list DRUPAL_MODULES_TO_INSTALL:<module1> <module2> <module3>....<module n>
#Only activate one of these examples at a time or configure your own according to you needs
#Example 1 - install the tara theme (https://www.drupal.org/project/tara)
#DRUPALCMS_THEMES_TO_INSTALL:tara:^11.0
#Example 2 - install the mercury theme (https://www.drupal.org/project/mercury)
#DRUPALCMS_THEMES_TO_INSTALL:mercury:^1.0
#DUPALCMS_MODULES_TO_INSTALL:cva:^1.0
#Example 3 - install the bootstrap theme (https://www.drupal.org/project/bootstrap)
#DRUPALCMS_THEMES_TO_INSTALL:bootstrap:^3.40
#DRUPALCMS_MODULES_TO_INSTALL:jquery_ui:^1.8 jquery_ui_draggable:^2.1 jquery_ui_resizable:^2.1

######################################################################################################################################################
#This sets the webroot of your application. For drupal cms this shouldn't be changed for the application to work properly
######################################################################################################################################################
#WEBROOT_DIRECTORY:/var/www/html/cms

####################################################################################################################################
#This tells the system which files to exclude when a backup or baseline is made
####################################################################################################################################
#EXCLUDE_FROM_BACKUP:cms/web/sites/default/settings.php
###############################DRUPAL CMS####################################################


########################################################################################################################################################
#This is where the joomla configuration file is actually located (outside of the webroot) which makes backup processes easier as well as enhancing
#the security of our systems. Behind the scenes this is what is happening to make this settings file accessible to the main CMS
# /bin/ls -s /var/www/outside_webroot/settings.php ${webroot_directory}/site/default/settings.php
######################################################################################################################################################
CONFIG_FILE:/var/www/outside_webroot/settings.php

#########################################################################################################################
#The assets for your CMS are to be located outside of your webroot. This means makes it easy to give them different access
#permissions to the rest of the application as they are to be dynamically updatable at all times and you might therefore
#want to use a different permission set. 
#ASSETS_DIRECTORIES_TO_LINK links a subdirectory of the webroot to the actual assets directory outside of the webroot. You can provide
#a colon separated list of asset directories that you want to be linked to actual assets directories outside of your webroot for example:
#ASSETS_DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/images/members|/var/www/outside_webroot/images/members:XXXXWEBROOT_DIRECTORYXXXX/images/system|/var/www/outside_webroot/images/user/system
#You aren't only limied to linking assets directories outside of your webroot you can also link regular directories using DIRECTORIES_TO_LINK
#WEBROOT_ASSET_DIRECTORIES must be a one to one correlation with ASSETS_DIRECTORIES_TO_LINK
#These links aren't actioned for virgin or baseline builds all the asset files are of a baseline or a virgin build are directly under the webroot
#without any symlinks to directories outside of the webroot
######################################################################################################################################################
WEBROOT_ASSET_DIRECTORIES:web/sites/default/files
ASSETS_DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/web/sites/default/files|/var/www/outside_webroot/sites/default/files
DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/tmp|/var/www/outside_webroot/tmp:XXXXWEBROOT_DIRECTORYXXXX/logs|/var/www/outside_webroot/logs:XXXXWEBROOT_DIRECTORYXXXX/cache|/var/www/outside_webroot/cache



#####################################################################################################################################################
#These settings pick various directories and files which should be present in a drupal installation. What that means is that if there is a partial
#download or extraction of drupal and some files are missing by using these files to check the intergrity of the installtion we can detect this
#and make a notification
######################################################################################################################################################
APPLICATION_INTEGRITY_DIRECTORIES:core:modules:profiles:sites:themes:../vendor
APPLICATION_INTEGRITY_FILES:autoload.php:index.php:update.php

#####################################################################################################################################################
#Interactive install or not
#If this is set to "yes" then during installation the build will pause until you navigate to your website and enter database credentials and so on.
#In interactive mode, the database credentials, database identifier and port are displayed as part of the build logging output and you can find out
#what they are in ${BUILD_HOME}/runtime/${CLOUDHOST}/${BUILD_IDENTIFIER}/logs
#If this is set to "no" then the installtion should complete without pausing and you will be able to access your drupal application straight away
#without providing any input
#####################################################################################################################################################
INTERACTIVE_APPLICATION_INSTALL:no

#########################################################################################################################
#The assets for your CMS are to be located outside of your webroot. This means makes it easy to give them different access
#permissions to the rest of the application as they are to be dynamically updatable at all times and you might therefore
#want to use a different permission set. 
#ASSETS_DIRECTORIES_TO_LINK links a subdirectory of the webroot to the actual assets directory outside of the webroot. You can provide
#a colon separated list of asset directories that you want to be linked to actual assets directories outside of your webroot for example:
#ASSETS_DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/images/members|/var/www/outside_webroot/images/members:XXXXWEBROOT_DIRECTORYXXXX/images/system|/var/www/outside_webroot/images/user/system
#You aren't only limied to linking assets directories outside of your webroot you can also link regular directories using DIRECTORIES_TO_LINK
#WEBROOT_ASSET_DIRECTORIES must be a one to one correlation with ASSETS_DIRECTORIES_TO_LINK
#These links aren't actioned for virgin or baseline builds all the asset files are of a baseline or a virgin build are directly under the webroot
#without any symlinks to directories outside of the webroot
######################################################################################################################################################
WEBROOT_ASSET_DIRECTORIES:sites/default/files
ASSETS_DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/web/sites/default/files|/var/www/outside_webroot/sites/default/files
DIRECTORIES_TO_LINK:XXXXWEBROOT_DIRECTORYXXXX/tmp|/var/www/outside_webroot/tmp:XXXXWEBROOT_DIRECTORYXXXX/logs|/var/www/outside_webroot/logs:XXXXWEBROOT_DIRECTORYXXXX/cache|/var/www/outside_webroot/cache

###########################################################################################
#Here you can list PHP modules that are required by drupal and the system will install them 
###########################################################################################
PHP_MODULES:apcu:curl:dom:gd:mbstring:mysqli:common:pgsql:xml:tokenizer:zip
CONFIG_PHP_INI:memory_limit=128M:file_uploads=On:session.save_handler=files:session.save_path=/var/run/session:upload_max_filesize=64M:post_max_size=64M:max_input_vars=5000:zlib.output_compression=On:cgi.fix_pathinfo=1:output_buffering=Off:disable_functions=exec,passthru,shell_exec,system,popen,parse_ini_file,show_source:allow_url_fopen=Off:allow_url_include=Off:memory_limit=256M:opcache.enable=1:opcache.memory_consumption=256:open_basedir=/var/log##/var/run##/var/cache##/var/www/html##/tmp##/var/www/outside_webroot:upload_tmp_dir=/var/www/html/tmp:sys_temp_dir=/var/www/html/tmp:expose_php=Off:date.timezone='Europe/London':cgi.force_redirect=On   
CONFIG_PHP_POOL:pm=ondemand:pm.max_children=10:pm.max_requests=200:pm.start_servers=10:pm.min_spare_servers=5:pm.max_spare_servers=20:pm.process_idle_timeout=10s

#####################################################################################################################################################
# Mandatory credential settings when making a non-interactive installation
#These are mandatory database settings that are absolutely required for there to be any chance of your application coming online if you are installing
#drupal non-interactively. Notice that placeholders are used and are populated privately with live data in the script
# ${BUILD_HOME}/application/drupal/SetApplicationConfig.sh
#####################################################################################################################################################
MANDATORY_INDIVIDUAL_SETTING:username=XXXXAPPLICATION_USERNAMEXXXX
MANDATORY_INDIVIDUAL_SETTING:password=XXXXAPPLICATION_PASSWORDXXXX
MANDATORY_INDIVIDUAL_SETTING:database=XXXXAPPLICATION_DATABASEXXXX
MANDATORY_INDIVIDUAL_SETTING:collation=utf8mb4_general_ci
MANDATORY_INDIVIDUAL_SETTING:hash_salt=XXXXHASH_SALTXXXX

#########################################################################################################################################################
# General individual settings for your drupal install
#These settings are general configuration settings for drupal. You can set various behaviours using these settings. In a live situation you could have
#a set of configuration files such as /var/www/html/settings.php or /var/www/html/settings-debug.php and you can switch from one configuration
#to another (if you want to debug for example you can switch to your debug configuration) simply by changing the configuration file which is pointed to
#in /var/www/html/drupal/settings.php. Again notice the placeholders that are swapped out as part of the build process
#########################################################################################################################################################
ADDITIONAL_SETTING:$settings['package_manager_composer_path'] = '/usr/local/bin/composer';
ADDITIONAL_SETTING:$settings['package_manager_rsync_path'] = '/usr/bin/rsync';
ADDITIONAL_SETTING:$settings['testing_package_manager'] = TRUE;
ADDITIONAL_SETTING:$config["system.logging"]["error_level"] = "error";
ADDITIONAL_SETTING:$settings["trusted_host_patterns"] = [ preg_quote('XXXXWEBSITE_URLXXXX'),"localhost",preg_quote('127.0.0.1'),preg_quote('XXXXBUILD_MACHINE_IPXXXX'),preg_quote('XXXXPRIVATE_IPXXXX') ];
ADDITIONAL_SETTING:$settings["config_sync_directory"] = "XXXXWEBROOT_DIRECTORYXXXX/web/sites/default";
ADDITIONAL_SETTING:$config["system.performance"]["css"]["preprocess"] = FALSE;
ADDITIONAL_SETTING:$config["system.performance"]["js"]["preprocess"] = FALSE;
ADDITIONAL_SETTING:$settings["file_private_path"] = "XXXXWEBROOT_DIRECTORYXXXX/private";

 
