##########################################################################################################################################
# This is an application descriptor for Open Source Social Network. 
# https://github.com/Iqbolshoh/php-social-messenger
# Using this technique you can automate the installation of social messenger
# Using descriptors we can aim for consistent installation processes which takes some of the potential for error out of the 
# installation process.
##########################################################################################################################################

##########################################################################################################################################
# social messenger is available on github
##########################################################################################################################################
#To install from a git branch, use this
SOCIAL-MESSENGER:git-branch:main

###############################################################################
#A list of any libraries that need to be installed for your application to work
###############################################################################
REQUIRED_SOFTWARE_LIBRARIES:

######################################################################################################################################################
#This sets the webroot of your application. You can change this according to your taste. 
######################################################################################################################################################
WEBROOT_DIRECTORY:/var/www/html/social-messenger

########################################################################################################################################################
#This sets the social messenger config file(s) to be outside of the webroot. 
######################################################################################################################################################
CONFIG_FILE:/var/www/outside_webroot/config.php

#############################################################################################################################################
#This will only apply for a temporal build not for a baseline build or a virgin build
#Configured as shown and with PERSIST_ASSETS_TO_DATASTORE=1 or 2 the system will create a symlink from ${webroot_directory}/images
#to /var/www/outside_webroot/images which will be a mountpoint where an S3 bucket is mounted for assets to be offloaded to S3
#Again, if it is a baseline or a virgin build this setting is ignored. 
#ASSET_DIRECTORIES_LINKED_OUTSIDE_WEBROOT:images
############################################################################################################################################
ASSET_DIRECTORIES_LINKED_OUTSIDE_WEBROOT:

#############################################################################################################################################
#This will link any directory to a directory outside of the webroot. This is useful from a management point of view meaning that you can link
#(for example) a directory with logs or a caching directory to a directory outside of your webroot and it will definitely not be included in 
#the any backups that are made because the backup process doesn't follow symlinks (that said you should still also add it to the 
#EXCLUDE_FROM_BACKUP setting to be very sure that its not included in any backup process
#If you had a plugin that requires you create your cache directory under ${webroot_directory}/cache then you can arrange for the content of that directory
#to be outside of your webroot for management reasons by setting a value as shown below
#and that will symlink ${webroot_directory}/cache to /var/www/outside-webroot/cache
#DIRECTORIES_LINKED_OUTSIDE_WEBROOT:cache
#############################################################################################################################################
DIRECTORIES_LINKED_OUTSIDE_WEBROOT:

#################################################################################################################################################
#directories to be created outside of the webroot that you don't want linked to from with the webroot. You might want to access these directories
#by setting, for example in your configuration.php  file
# log_path='/var/www/outside_webroot/logs'
# tmp_path='/var/www/outside_webroot/tmp'
# cache_path='/var/www/outside_webroot/cache'
# So simply setting these values shown below will automatically create these directories for you without any symlinks from with the webroot
#
# /var/www/outside_webroot/logs
# /var/www/outside_webroot/tmp
# /var/www/outside_webroot/cache
#
#################################################################################################################################################
DIRECTORIES_OUTSIDE_WEBROOT:logs:tmp:cache

####################################################################################################################################
#This tells the system which files or directories to exclude when a baseline is made. Anything that contains sensitive information
#from within your webroot can be excluded from the baseline here. 
####################################################################################################################################
EXCLUDE_FROM_BASELINE:config.php

####################################################################################################################################
#This tells the system which files or directories to exclude when a backup is made. Anything that contains sensitive information
#from within your webroot can be excluded from the backup here. 
####################################################################################################################################
EXCLUDE_FROM_BACKUP:config.php

#####################################################################################################################################################
#Interactive install or not
#If this is set to "yes" then during installation the build will pause until you navigate to your website and enter database credentials and so on.
#In interactive mode, the database credentials, database identifier and port are displayed as part of the build logging output and you can find out
#what they are in ${BUILD_HOME}/runtime/${CLOUDHOST}/${BUILD_IDENTIFIER}/logs
#If this is set to "no" then the installtion should complete without pausing and you will be able to access your ossn application straight away
#without providing any input
#####################################################################################################################################################
INTERACTIVE_APPLICATION_INSTALL:no
  
#####################################################################################################################################################
#These settings pick various directories and files which should be present in a ossn installation. What that means is that if there is a partial
#download or extraction of ossn and some files are missing by using these files to check the intergrity of the installtion we can detect this
#and make a notification
######################################################################################################################################################
APPLICATION_INTEGRITY_DIRECTORIES:api:login:logout:signup:src
APPLICATION_INTEGRITY_FILES:chat.php:database.sql:favicon.ico:index.php:README.md

###########################################################################################
#Here you can list PHP modules that are required by ossn and the system will install them 
###########################################################################################
#PHP_VERSION:8.5
PHP_MODULES:curl:mysqli:mbstring 
CONFIG_PHP_INI:memory_limit=128M:file_uploads=On:session.save_handler=files:session.save_path=/var/run/session:upload_max_filesize=64M:post_max_size=64M:max_input_vars=5000:zlib.output_compression=Off:cgi.fix_pathinfo=0:output_buffering=Off:disable_functions=exec,passthru,shell_exec,system,popen,parse_ini_file,show_source:allow_url_fopen=Off:allow_url_include=Off:memory_limit=256M:opcache.enable=1:opcache.memory_consumption=256:open_basedir=/var/log##/var/run##/var/cache##/var/www/html##/var/www/outside_webroot:upload_tmp_dir=/var/www/outside_webroot/tmp:sys_temp_dir=/var/www/outside_webroot/tmp:expose_php=Off:date.timezone='Europe/London':cgi.force_redirect=On   
CONFIG_PHP_POOL:pm=ondemand:pm.max_children=10:pm.max_requests=200:pm.start_servers=10:pm.min_spare_servers=5:pm.max_spare_servers=20:pm.process_idle_timeout=10s

#####################################################################################################################################################
# Mandatory credential settings when making a non-interactive installation
# These are mandatory database settings that are absolutely required for there to be any chance of your application coming online if you are installing
# social messenger non-interactively. Notice that placeholders are used and are populated privately with live data in the script
# ${BUILD_HOME}/application/social-messenger/SetApplicationConfig.sh
#####################################################################################################################################################
MANDATORY_INDIVIDUAL_SETTING:user='XXXXAPPLICATION_USERNAMEXXXX'
MANDATORY_INDIVIDUAL_SETTING:password='XXXXAPPLICATION_PASSWORDXXXX'
MANDATORY_INDIVIDUAL_SETTING:db='XXXXAPPLICATION_DATABASEXXXX'

