---
- name: Delete all existing IP addresses (A and AAAA records) for a domain on Linode DNS
  hosts: localhost
  gather_facts: false
  vars:
    # Pass your Linode Personal Access Token as an environment variable
    linode_api_token: "{{ lookup('ansible.builtin.env', 'LINODE_API_TOKEN') }}"
    # Define your targeted domain name here
    target_domain: "example.com"

  tasks:
    - name: Ensure Linode API token is provided
      ansible.builtin.fail:
        msg: "Please set the LINODE_API_TOKEN environment variable."
      when: linode_api_token is not defined or linode_api_token == ""

    - name: Get the Domain ID for the target domain
      ansible.builtin.uri:
        url: "https://linode.com"
        method: GET
        headers:
          Authorization: "Bearer {{ linode_api_token }}"
          Accept: "application/json"
      register: domains_response

    - name: Set Domain ID fact
      ansible.builtin.set_fact:
        domain_id: "{{ (domains_response.json.data | selectattr('domain', 'equalto', target_domain) | map(attribute='id') | list)[0] | default(none) }}"

    - name: Fail if domain is not found
      ansible.builtin.fail:
        msg: "Domain {{ target_domain }} was not found in your Linode account."
      when: domain_id is none

    - name: Get all DNS records for the domain
      ansible.builtin.uri:
        url: "https://linode.com/{{ domain_id }}/records"
        method: GET
        headers:
          Authorization: "Bearer {{ linode_api_token }}"
          Accept: "application/json"
      register: records_response

    - name: Filter A and AAAA records
      ansible.builtin.set_fact:
        ip_records: "{{ records_response.json.data | selectattr('type', 'in', ['A', 'AAAA']) | list }}"

    - name: Delete each A and AAAA record
      ansible.builtin.uri:
        url: "https://linode.com/{{ domain_id }}/records/{{ item.id }}"
        method: DELETE
        headers:
          Authorization: "Bearer {{ linode_api_token }}"
        status_code: [200]
      loop: "{{ ip_records }}"
      loop_control:
        label: "Deleting {{ item.type }} record: {{ item.name or '@' }} -> {{ item.target }}"
      when: ip_records | length > 0

    - name: Print summary of deletion
      ansible.builtin.debug:
        msg: "Successfully deleted {{ ip_records | length }} IP address record(s) for {{ target_domain }}."
