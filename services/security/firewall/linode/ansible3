---
- name: Manage Linode Firewalls natively
  hosts: localhost
  gather_facts: false

  tasks:
    - name: Create or Update a Cloud Firewall with standard rules
      linode.cloud.firewall:
        api_token: "{{ linode_api_token }}"
        label: "{{ firewall_name }}"
        status: "{{ status }}"
        inbound_policy: "drop"
        inbound:
          - label: "{{ rule_name }}"
            action: "accept"
            protocol: "{{ protocol }}"
            ports: "{{ port }}"
            addresses:
              ipv4: ["{{ ip_address }}"]
        # Outbound structural logic (Allow all egress traffic)
        outbound_policy: "accept"
        outbound: []
        state: present
      register: firewall_output

    - name: Print the newly generated or matched Firewall details
      ansible.builtin.debug:
        msg: "The Firewall ID is: {{ firewall_output.firewall.id }}"

    - name: List accessible Firewalls to confirm configuration
      linode.cloud.firewall_list:
        api_token: "{{ linode_api_token }}"
        filters:
          - name: label
            values: "{{ firewall_name }}"
      register: firewall_search_results
