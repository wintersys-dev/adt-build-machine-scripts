


firewall_id="$(${BUILD_HOME}/services/security/firewall/linode/api/GetFirewallID.sh)"


if [ "${firewall_id}" = "" ] 
then
        ${BUILD_HOME}/services/security/firewall/linode/api/CreateFirewall.sh ${firewall_name}
else
        ${BUILD_HOME}/services/security/firewall/linode/api/ResetFirewall.sh ${firewall_id}
fi              

/bin/echo "Authorization: Bearer ${TOKEN}" | curl -H @- -s -X PUT "https://api.linode.com/v4/networking/firewalls/${firewall_id}/rules" --json "$(jq -n --argjson rules "${ruleset}" '{inbound: $rules}')"
if [ "$?" != "0" ]   
then
        status "Unable to update firewall rules"
        exit 1          
fi                              

if ( [ "$?" = "0" ] )
then
        /bin/echo "ADT_FIREWALL_ID:${firewall_id}"
fi
