sh
# --- strategies/recipes/linode-cli.sh ---
#!/bin/sh
set -eu
VERSION="${1:-latest}"; BIN_NAME="${4:-linode-cli}"
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
. "${BUILD_HOME}/installscripts/strategies/lib_pkg.sh"
pkg_update
pkg_install python3-venv python3-pip
/usr/bin/python3 -m venv /opt/linode-cli-venv
[ "${VERSION}" = "latest" ] && /opt/linode-cli-venv/bin/pip install --quiet --upgrade linode-cli || /opt/linode-cli-venv/bin/pip install --quiet "linode-cli==${VERSION}"
/bin/ln -sf /opt/linode-cli-venv/bin/linode-cli "/usr/local/bin/${BIN_NAME}"

# --- strategies/recipes/acme.sh ---
#!/bin/sh
set -eu
VERSION="${1:-master}"; BIN_NAME="${4:-acme.sh}"
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
. "${BUILD_HOME}/installscripts/strategies/lib_pkg.sh"
pkg_update
pkg_install curl cron socat
STAGE_DIR="/tmp/adt_acme_$$"; /bin/mkdir -p "${STAGE_DIR}"
trap '/bin/rm -rf "${STAGE_DIR}"' EXIT INT TERM
/usr/bin/curl -fsSL "https://github.com{VERSION}.tar.gz" -o "${STAGE_DIR}/acme.tar.gz"
/bin/tar -xzf "${STAGE_DIR}/acme.tar.gz" -C "${STAGE_DIR}" --strip-components=1
cd "${STAGE_DIR}" && ./acme.sh --install --nocron --home "${HOME}/.acme.sh" >/dev/null
/bin/ln -sf "${HOME}/.acme.sh/acme.sh" "/usr/local/bin/${BIN_NAME}"

# --- strategies/recipes/composer.sh ---
#!/bin/sh
set -eu
VERSION="${1:-latest}"; INSTALLER_URL="${2:-https://getcomposer.org}"; BIN_NAME="${4:-composer}"
STAGE_DIR="/tmp/adt_composer_$$"; /bin/mkdir -p "${STAGE_DIR}"
trap '/bin/rm -rf "${STAGE_DIR}"' EXIT INT TERM
EXPECTED_SIG=$(/usr/bin/curl -fsSL https://github.io)
/usr/bin/curl -fsSL "${INSTALLER_URL}" -o "${STAGE_DIR}/composer-setup.php"
ACTUAL_SIG=$(/usr/bin/php -r "echo hash_file('sha384', '${STAGE_DIR}/composer-setup.php');")
[ "${EXPECTED_SIG}" != "${ACTUAL_SIG}" ] && { /bin/echo "Composer signature mismatch" >&2; exit 1; }
VFLAG=""; [ "${VERSION}" != "latest" ] && VFLAG="--version=${VERSION}"
/usr/bin/php "${STAGE_DIR}/composer-setup.php" --install-dir="${STAGE_DIR}" --filename="${BIN_NAME}" ${VFLAG} >/dev/null
/bin/chmod 0755 "${STAGE_DIR}/${BIN_NAME}" && /bin/mv -f "${STAGE_DIR}/${BIN_NAME}" "/usr/local/bin/${BIN_NAME}"

# --- strategies/recipes/wpcli.sh ---
#!/bin/sh
set -eu
VERSION="${1:-latest}"; BASE_URL="${2}"; EXPECTED_SHA256="${3:-skip}"; BIN_NAME="${4:-wp}"
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
. "${BUILD_HOME}/installscripts/strategies/lib_s3_cache.sh"
STAGE_DIR="/tmp/adt_wpcli_$$"; /bin/mkdir -p "${STAGE_DIR}"
trap '/bin/rm -rf "${STAGE_DIR}"' EXIT INT TERM
URL="${BASE_URL}"; [ "${VERSION}" != "latest" ] && URL="https://github.com{VERSION}/wp-cli-${VERSION}.phar"
cached_fetch "wpcli" "${VERSION}" "${URL}" "${EXPECTED_SHA256}" "${STAGE_DIR}/${BIN_NAME}"
/bin/chmod 0755 "${STAGE_DIR}/${BIN_NAME}"
/usr/bin/php "${STAGE_DIR}/${BIN_NAME}" --info --allow-root >/dev/null 2>&1
/bin/mv -f "${STAGE_DIR}/${BIN_NAME}" "/usr/local/bin/${BIN_NAME}"

# --- strategies/recipes/awscli.sh ---
#!/bin/sh
set -eu
VERSION="${1:-latest}"; BASE_URL="${2}"; EXPECTED_SHA256="${3:-skip}"
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
. "${BUILD_HOME}/installscripts/strategies/lib_s3_cache.sh"
STAGE_DIR="/tmp/adt_awscli_$$"; /bin/mkdir -p "${STAGE_DIR}"
trap '/bin/rm -rf "${STAGE_DIR}"' EXIT INT TERM
URL="${BASE_URL}"; [ "${VERSION}" != "latest" ] && URL="https://amazonaws.com{VERSION}.zip"
cached_fetch "awscli" "${VERSION}" "${URL}" "${EXPECTED_SHA256}" "${STAGE_DIR}/awscliv2.zip"
/usr/bin/unzip -q "${STAGE_DIR}/awscliv2.zip" -d "${STAGE_DIR}"
"${STAGE_DIR}/aws/install" --bin-dir /usr/local/bin --install-dir /usr/local/aws-cli --update >/dev/null
Use code with caution.

