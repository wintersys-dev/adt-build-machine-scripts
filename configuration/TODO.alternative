#!/bin/sh
set -eu
VERSION="${1:-latest}"; URL="$2"; EXPECTED_SHA256="${3:-skip}"; BIN_NAME="$4"
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
. "${BUILD_HOME}/installscripts/strategies/lib_s3_cache.sh"
. "${BUILD_HOME}/installscripts/strategies/lib_pkg.sh"

pkg_update
pkg_install fuse3 ca-certificates

STAGE_BIN="/tmp/adt_${BIN_NAME}_$$"
trap '/bin/rm -f "${STAGE_BIN}"' EXIT INT TERM
cached_fetch "${BIN_NAME}" "${VERSION}" "${URL}" "${EXPECTED_SHA256}" "${STAGE_BIN}"
/bin/chmod 0755 "${STAGE_BIN}"
/bin/mv -f "${STAGE_BIN}" "/usr/local/bin/${BIN_NAME}"
