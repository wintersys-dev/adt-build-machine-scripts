3. ${BUILD_HOME}/installscripts/install_software.sh

sh
#!/bin/sh
#: Name:        install_software.sh
#: Purpose:     Orchestrates selective installation of system packages and pinned tool drivers from software.dat.
#: Author:      Peter Winter
#: Date:        20/11/2026
#: Version:     2.1
#:
#: Usage:       install_software.sh [--dry-run|-n] [server_role] [path-to-manifest.dat]
#:              install_software.sh [-h|--help]
set -eu

DRY_RUN=0
SERVER_ROLE=""
MANIFEST=""

for arg in "$@"; do
    case "$arg" in
        -h|--help)
            /usr/bin/grep '^#:' "$0" | /usr/bin/cut -c 4-
            exit 0
            ;;
        -n|--dry-run)
            DRY_RUN=1
            ;;
        *)
            if [ -z "$SERVER_ROLE" ]; then
                SERVER_ROLE="$arg"
            elif [ -z "$MANIFEST" ]; then
                MANIFEST="$arg"
            else
                printf 'Error: Unexpected argument "%s"\n' "$arg" >&2
                exit 1
            fi
            ;;
    esac
done

if [ -r /home/buildhome.dat ]; then
    BUILD_HOME="$(/bin/cat /home/buildhome.dat)"
else
    /bin/echo "Application root configuration file missing at /home/buildhome.dat" >&2
    exit 1
fi

export BUILD_HOME
. "${BUILD_HOME}/installscripts/lib/artifact_cache.sh"

SERVER_ROLE="${SERVER_ROLE:-all}"
MANIFEST="${MANIFEST:-${BUILD_HOME}/configuration/software.dat}"
DRIVERS_DIR="${BUILD_HOME}/installscripts/drivers"

if [ ! -r "$MANIFEST" ]; then
    status "Error: Manifest file missing or unreadable at ${MANIFEST}"
    exit 1
fi

CLOUDHOST="${CLOUDHOST:-$("${BUILD_HOME}/helpers/services/GetVariableValue.sh" CLOUDHOST 2>/dev/null || true)}"

SYSTEM_PKGS=""
DRIVER_LIST=""

should_install() {
    scope_list="$1"
    [ -z "$scope_list" ] && return 0

    old_ifs="$IFS"
    IFS=','
    for token in $scope_list; do
        case "$token" in
            all|"$CLOUDHOST"|"$SERVER_ROLE")
                IFS="$old_ifs"
                return 0
                ;;
        esac
    done
    IFS="$old_ifs"
    return 1
}

# 1. Parse manifest, filter by scope, and prioritize DATASTORETOOL first
while IFS=':' read -r type arg1 arg2 scope; do
    case "$type" in
        ""|\#*) continue ;;
    esac

    should_install "$scope" || continue

    case "$type" in
        DATASTORETOOL)
            if [ -n "$arg2" ]; then
                DRIVER_LIST="${arg1}:${arg2} $DRIVER_LIST"
            else
                SYSTEM_PKGS="$SYSTEM_PKGS $arg1"
            fi
            ;;
        SYSTEM)            SYSTEM_PKGS="$SYSTEM_PKGS $arg1" ;;
        PINNED|PINNED_PIP) DRIVER_LIST="$DRIVER_LIST ${arg1}:${arg2}" ;;
        *)
            status "Error: Unknown directive '${type}' in ${MANIFEST}"
            exit 1
            ;;
    esac
done < "$MANIFEST"

# 2. Validate that all matched drivers exist on disk before making any changes
for item in $DRIVER_LIST; do
    tool="${item%%:*}"
    driver="${DRIVERS_DIR}/${tool}.sh"
    if [ ! -f "$driver" ]; then
        status "Error: Missing driver script ${driver} for tool '${tool}'"
        exit 1
    fi
done

# 3. Preview execution plan and exit cleanly if --dry-run was requested
if [ "$DRY_RUN" -eq 1 ]; then
    printf '=== DRY-RUN EXECUTION PLAN ===\n'
    printf 'Manifest:    %s\n' "$MANIFEST"
    printf 'Cloudhost:   %s\n' "${CLOUDHOST:-<unset>}"
    printf 'Server Role: %s\n\n' "$SERVER_ROLE"

    printf ' SYSTEM PACKAGES (via nala):\n'
    if [ -n "$SYSTEM_PKGS" ]; then
        for pkg in $SYSTEM_PKGS; do
            printf '    - %s\n' "$pkg"
        done
    else
        printf '    (none)\n'
    fi

    printf '\n PINNED DRIVERS (in execution order):\n'
    if [ -n "$DRIVER_LIST" ]; then
        for item in $DRIVER_LIST; do
            printf '    - %s (version %s) -> %s/%s.sh\n' \
                "${item%%:*}" "${item#*:}" "$DRIVERS_DIR" "${item%%:*}"
        done
    else
        printf '    (none)\n'
    fi
    exit 0
fi

# 4. Wait for dpkg/apt locks, ensure nala exists, and batch-install SYSTEM packages
wait_for_apt_lock

if ! command -v nala >/dev/null 2>&1; then
    status "Bootstrapping nala package manager..."
    apt-get update -y
    apt-get install -y nala
fi

nala update
# shellcheck disable=SC2086
nala install -y curl tar unzip ca-certificates psmisc $SYSTEM_PKGS

# 5. Execute each matching tool driver (DATASTORETOOL runs & self-caches first)
for item in $DRIVER_LIST; do
    tool="${item%%:*}"
    ver="${item#*:}"
    sh "${DRIVERS_DIR}/${tool}.sh" "$ver"
done

status "Software installation completed cleanly for role '${SERVER_ROLE}' (${CLOUDHOST:-unknown})."
Use code with caution.

4. ${BUILD_HOME}/installscripts/lib/artifact_cache.sh

sh
#!/bin/sh
#: Name:        artifact_cache.sh
#: Purpose:     Shared library for APT lock safety, S3 pull-through caching, and upstream SHA256 verification.

if [ -z "${BUILD_HOME:-}" ]; then
    if [ -r /home/buildhome.dat ]; then
        BUILD_HOME="$(/bin/cat /home/buildhome.dat)"
    else
        /bin/echo "Application root configuration file missing at /home/buildhome.dat" >&2
        exit 1
    fi
fi

DATASTORE_OPS="${BUILD_HOME}/services/datastore/operations"
GET_SCRIPT="${DATASTORE_OPS}/GetFromDatastore.sh"
PUT_SCRIPT="${DATASTORE_OPS}/PutToDatastore.sh"
MOUNT_SCRIPT="${DATASTORE_OPS}/MountDatastore.sh"
ARTIFACT_BUCKET="${ARTIFACT_BUCKET:-adt-binary-cache}"

if [ -z "${TMP_DIR:-}" ]; then
    TMP_DIR="$(mktemp -d)"
    trap 'rm -rf "$TMP_DIR"' EXIT INT TERM
fi

ARCHIVE_MISS=0
CHECKSUM_MISS=0

status() {
    if [ -x "${BUILD_HOME}/helpers/services/LogStatusMessages.sh" ]; then
        "${BUILD_HOME}/helpers/services/LogStatusMessages.sh" "${1}" "${2:-no}" 2>/dev/null || true
    else
        printf '%s\n' "${1}"
    fi
}

wait_for_apt_lock() {
    attempts=0
    while [ "$attempts" -lt 24 ]; do
        if ! fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 &&
           ! fuser /var/lib/apt/lists/lock >/dev/null 2>&1 &&
           ! fuser /var/cache/apt/archives/lock >/dev/null 2>&1; then
            return 0
        fi
        status "Waiting for dpkg/apt lock to clear before installing system packages..."
        attempts=$((attempts + 1))
        sleep 5
    done
    status "Error: Timed out waiting for dpkg/apt lock after 120 seconds."
    exit 1
}

pull_file() {
    remote_path="$1"
    upstream_url="$2"
    dest="$3"

    if [ -x "$GET_SCRIPT" ]; then
        if "$GET_SCRIPT" "ad-hoc" "$remote_path" "$dest" "$ARTIFACT_BUCKET" >/dev/null 2>&1 && [ -s "$dest" ]; then
            return 0
        fi
    fi

    [ -n "$upstream_url" ] || return 1
    curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 15 "$upstream_url" -o "$dest"
    return 1
}

resolve_expected_sha256() {
    checksum_file="$1"
    target_file="$2"

    awk -v f="$target_file" '
        {
            name = $2
            sub(/^\*/, "", name)
            sub(/^.*\//, "", name)
            if (name == f || NF == 1) {
                print tolower($1)
                exit
            }
        }
    ' "$checksum_file"
}

fetch_and_verify() {
    bucket_dir="$1"
    filename="$2"
    upstream_url="$3"
    checksum_url="$4"
    dest="$5"

    ARCHIVE_MISS=0
    CHECKSUM_MISS=0

    if pull_file "${bucket_dir}/${filename}" "$upstream_url" "$dest"; then
        status "[DATASTORE HIT] ${bucket_dir}/${filename}"
    else
        status "[DATASTORE MISS] Fetched ${bucket_dir}/${filename} from upstream"
        ARCHIVE_MISS=1
    fi

    [ -z "$checksum_url" ] && return 0

    checksum_name="${filename}.sha256"
    checksum_dest="${TMP_DIR}/${checksum_name}"

    if ! pull_file "${bucket_dir}/${checksum_name}" "$checksum_url" "$checksum_dest"; then
        CHECKSUM_MISS=1
    fi

    expected_sha="$(resolve_expected_sha256 "$checksum_dest" "$filename")"
    if [ -z "$expected_sha" ]; then
        status "Error: Could not find SHA256 hash for ${filename} inside ${checksum_url}"
        exit 1
    fi

    actual_sha="$(sha256sum "$dest" | awk '{print $1}')"
    if [ "$actual_sha" != "$expected_sha" ]; then
        status "Error: SHA256 mismatch for ${filename} (expected ${expected_sha}, got ${actual_sha})"
        exit 1
    fi

    status "[SHA256 OK] ${filename}"
}

seed_datastore() {
    bucket_dir="$1"
    archive_file="$2"
    checksum_file="${archive_file}.sha256"

    [ "$ARCHIVE_MISS" -eq 1 ] || [ "$CHECKSUM_MISS" -eq 1 ] || return 0

    if [ -x "$MOUNT_SCRIPT" ]; then
        "$MOUNT_SCRIPT" "ad-hoc" "distributed" "$ARTIFACT_BUCKET" >/dev/null 2>&1 || true
    fi

    if [ "$ARCHIVE_MISS" -eq 1 ] && [ -x "$PUT_SCRIPT" ] && [ -s "$archive_file" ]; then
        "$PUT_SCRIPT" "ad-hoc" "$archive_file" "$bucket_dir" "distributed" "false" "$ARTIFACT_BUCKET" >/dev/null 2>&1 || true
    fi

    if [ "$CHECKSUM_MISS" -eq 1 ] && [ -x "$PUT_SCRIPT" ] && [ -s "$checksum_file" ]; then
        "$PUT_SCRIPT" "ad-hoc" "$checksum_file" "$bucket_dir" "distributed" "false" "$ARTIFACT_BUCKET" >/dev/null 2>&1 || true
    fi
}
Use code with caution.

5. ${BUILD_HOME}/installscripts/drivers/*.sh


drivers/s5cmd.sh

sh
#!/bin/sh
set -eu
ver="${1:?Version required}"
. "${BUILD_HOME}/installscripts/lib/artifact_cache.sh"

dir="s5cmd/${ver}"
file="s5cmd_${ver}_Linux-64bit.tar.gz"
base="$(printf 'https://github.com' "$ver")"

fetch_and_verify "$dir" "$file" "${base}/${file}" "${base}/s5cmd_checksums.txt" "${TMP_DIR}/${file}"
tar -xzf "${TMP_DIR}/${file}" -C /usr/local/bin s5cmd
chmod +x /usr/local/bin/s5cmd
seed_datastore "$dir" "${TMP_DIR}/${file}"
Use code with caution.

drivers/rclone.sh

sh
#!/bin/sh
set -eu
ver="${1:?Version required}"
. "${BUILD_HOME}/installscripts/lib/artifact_cache.sh"

dir="rclone/${ver}"
file="rclone-v${ver}-linux-amd64.zip"
base="$(printf 'https://rclone.org' "$ver")"

fetch_and_verify "$dir" "$file" "${base}/${file}" "${base}/SHA256SUMS" "${TMP_DIR}/${file}"
unzip -p "${TMP_DIR}/${file}" "rclone-v${ver}-linux-amd64/rclone" > /usr/local/bin/rclone
chmod +x /usr/local/bin/rclone
seed_datastore "$dir" "${TMP_DIR}/${file}"
