Part 2: Headers, APT Lock Guard & S3 Cache Helpers (install_software.sh — Top Half)

sh
#!/bin/sh
#: Name:        install_software.sh
#: Purpose:     Selectively installs system packages, SHA256-verified CLI binaries, and cached Python wheels using an S3 pull-through cache.
#: Author:      Peter Winter
#: Date:        20/11/2026
#: Version:     2.0
#:
#: Usage:       install_software.sh [server_role] [path-to-manifest.dat]
#:              install_software.sh [-h|--help]
#:
#: Parameters:
#:   $1         [Optional] Server role filter (e.g., webserver, reverseproxy, authenticator, database, buildhost; defaults to "all")
#:   $2         [Optional] Path to manifest file (defaults to ${BUILD_HOME}/configuration/software.dat)
#:
#: Environment:
#:   BUILD_HOME Resolved automatically from /home/buildhome.dat
#:
#: Dependencies:
#:   - /home/buildhome.dat
#:   - ${BUILD_HOME}/configuration/software.dat
#:   - LogStatusMessages.sh
#:   - GetVariableValue.sh
#:   - GetFromDatastore.sh, PutToDatastore.sh, MountDatastore.sh
###################################################################################
# License Agreement:
# This file is part of The Wintersys Agile Deployment Toolkit.
# The Agile Deployment Toolkit is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.
# The Agile Deployment Toolkit is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
# You should have received a copy of the GNU General Public License
# along with The Agile Deployment Toolkit.  If not, see <http://gnu.org>.
###################################################################################
set -eu

# Render self-extracting help documentation when -h or --help is supplied
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    /usr/bin/grep '^#:' "$0" | /usr/bin/cut -c 4-
    exit 0
fi

# Resolve toolkit root directory
if [ -r /home/buildhome.dat ]; then
    BUILD_HOME="$(/bin/cat /home/buildhome.dat)"
else
    /bin/echo "Application root configuration file missing at /home/buildhome.dat" >&2
    exit 1
fi

status() {
    if [ -x "${BUILD_HOME}/helpers/services/LogStatusMessages.sh" ]; then
        "${BUILD_HOME}/helpers/services/LogStatusMessages.sh" "${1}" "${2:-no}" 2>/dev/null || true
    else
        printf '%s\n' "${1}"
    fi
}

SERVER_ROLE="${1:-${SERVER_ROLE:-all}}"
MANIFEST="${2:-${BUILD_HOME}/configuration/software.dat}"

if [ ! -r "$MANIFEST" ]; then
    status "Error: Manifest file missing or unreadable at ${MANIFEST}"
    exit 1
fi

CLOUDHOST="${CLOUDHOST:-$("${BUILD_HOME}/helpers/services/GetVariableValue.sh" CLOUDHOST 2>/dev/null || true)}"

DATASTORE_OPS="${BUILD_HOME}/services/datastore/operations"
GET_SCRIPT="${DATASTORE_OPS}/GetFromDatastore.sh"
PUT_SCRIPT="${DATASTORE_OPS}/PutToDatastore.sh"
MOUNT_SCRIPT="${DATASTORE_OPS}/MountDatastore.sh"
ARTIFACT_BUCKET="${ARTIFACT_BUCKET:-adt-binary-cache}"

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT INT TERM

SYSTEM_PKGS=""
PINNED_LIST=""
PIP_LIST=""
ARCHIVE_MISS=0
CHECKSUM_MISS=0

# Wait up to 120s for cloud-init or unattended-upgrades to release dpkg/apt locks on fresh boots
wait_for_apt_lock() {
    attempts=0
    while [ "$attempts" -lt 24 ]; do
        if ! fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 &&
           ! fuser /var/lib/apt/lists/lock >/dev/null 2>&1 &&
           ! fuser /var/cache/apt/archives/lock >/dev/null 2>&1; then
            return 0
        fi
        status "Waiting for dpkg/apt lock to clear before installing system packages..."
        attempts=$((attempts + 1))
        sleep 5
    done
    status "Error: Timed out waiting for dpkg/apt lock after 120 seconds."
    exit 1
}

# Returns 0 (true) if any comma-separated token matches 'all', CLOUDHOST, or SERVER_ROLE
should_install() {
    scope_list="$1"
    [ -z "$scope_list" ] && return 0

    old_ifs="$IFS"
    IFS=','
    for token in $scope_list; do
        case "$token" in
            all|"$CLOUDHOST"|"$SERVER_ROLE")
                IFS="$old_ifs"
                return 0
                ;;
        esac
    done
    IFS="$old_ifs"
    return 1
}

# Fetch a single file from ADT Datastore or fall back to upstream URL
pull_file() {
    remote_path="$1"
    upstream_url="$2"
    dest="$3"

    if [ -x "$GET_SCRIPT" ]; then
        if "$GET_SCRIPT" "ad-hoc" "$remote_path" "$dest" "$ARTIFACT_BUCKET" >/dev/null 2>&1 && [ -s "$dest" ]; then
            return 0
        fi
    fi

    [ -n "$upstream_url" ] || return 1
    curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 15 "$upstream_url" -o "$dest"
    return 1
}

# Extract expected SHA256 hash for target_file from an upstream checksum manifest
resolve_expected_sha256() {
    checksum_file="$1"
    target_file="$2"

    awk -v f="$target_file" '
        {
            name = $2
            sub(/^\*/, "", name)
            sub(/^.*\//, "", name)
            if (name == f || NF == 1) {
                print tolower($1)
                exit
            }
        }
    ' "$checksum_file"
}

# Fetch archive + optional upstream checksum file, verify SHA256 before extraction
fetch_and_verify() {
    bucket_dir="$1"
    filename="$2"
    upstream_url="$3"
    checksum_url="$4"
    dest="$5"

    ARCHIVE_MISS=0
    CHECKSUM_MISS=0

    if pull_file "${bucket_dir}/${filename}" "$upstream_url" "$dest"; then
        status "[DATASTORE HIT] ${bucket_dir}/${filename}"
    else
        status "[DATASTORE MISS] Fetched ${bucket_dir}/${filename} from upstream"
        ARCHIVE_MISS=1
    fi

    [ -z "$checksum_url" ] && return 0

    checksum_name="${filename}.sha256"
    checksum_dest="${TMP_DIR}/${checksum_name}"

    if ! pull_file "${bucket_dir}/${checksum_name}" "$checksum_url" "$checksum_dest"; then
        CHECKSUM_MISS=1
    fi

    expected_sha="$(resolve_expected_sha256 "$checksum_dest" "$filename")"
    if [ -z "$expected_sha" ]; then
        status "Error: Could not find SHA256 hash for ${filename} inside ${checksum_url}"
        exit 1
    fi

    actual_sha="$(sha256sum "$dest" | awk '{print $1}')"
    if [ "$actual_sha" != "$expected_sha" ]; then
        status "Error: SHA256 mismatch for ${filename} (expected ${expected_sha}, got ${actual_sha})"
        exit 1
    fi

    status "[SHA256 OK] ${filename}"
}

# Seed S3 bucket AFTER binary extraction (ensures DATASTORETOOL self-caches on first boot)
seed_datastore() {
    bucket_dir="$1"
    archive_file="$2"
    checksum_file="${archive_file}.sha256"

    [ "$ARCHIVE_MISS" -eq 1 ] || [ "$CHECKSUM_MISS" -eq 1 ] || return 0

    if [ -x "$MOUNT_SCRIPT" ]; then
        "$MOUNT_SCRIPT" "ad-hoc" "distributed" "$ARTIFACT_BUCKET" >/dev/null 2>&1 || true
    fi

    if [ "$ARCHIVE_MISS" -eq 1 ] && [ -x "$PUT_SCRIPT" ] && [ -s "$archive_file" ]; then
        "$PUT_SCRIPT" "ad-hoc" "$archive_file" "$bucket_dir" "distributed" "false" "$ARTIFACT_BUCKET" >/dev/null 2>&1 || true
    fi

    if [ "$CHECKSUM_MISS" -eq 1 ] && [ -x "$PUT_SCRIPT" ] && [ -s "$checksum_file" ]; then
        "$PUT_SCRIPT" "ad-hoc" "$checksum_file" "$bucket_dir" "distributed" "false" "$ARTIFACT_BUCKET" >/dev/null 2>&1 || true
    fi
}
Use code with caution.

Part 3: Binary/Wheel Installers & Main Execution Loop (install_software.sh — Bottom Half)

sh
install_pinned_binary() {
    tool="$1"
    ver="$2"
    gh="https://github.com"

    case "$tool" in
        s5cmd)
            dir="s5cmd/${ver}"
            file="s5cmd_${ver}_Linux-64bit.tar.gz"
            base="$(printf '%s/peak/s5cmd/releases/download/v%s' "$gh" "$ver")"
            fetch_and_verify "$dir" "$file" "${base}/${file}" "${base}/s5cmd_checksums.txt" "${TMP_DIR}/${file}"
            tar -xzf "${TMP_DIR}/${file}" -C /usr/local/bin s5cmd
            ;;
        rclone)
            dir="rclone/${ver}"
            file="rclone-v${ver}-linux-amd64.zip"
            base="$(printf 'https://rclone.org' "$ver")"
            fetch_and_verify "$dir" "$file" "${base}/${file}" "${base}/SHA256SUMS" "${TMP_DIR}/${file}"
            unzip -p "${TMP_DIR}/${file}" "rclone-v${ver}-linux-amd64/rclone" > /usr/local/bin/rclone
            ;;
        doctl)
            dir="doctl/${ver}"
            file="doctl-${ver}-linux-amd64.tar.gz"
            base="$(printf '%s/digitalocean/doctl/releases/download/v%s' "$gh" "$ver")"
            fetch_and_verify "$dir" "$file" "${base}/${file}" "${base}/doctl-${ver}-checksums.sha256" "${TMP_DIR}/${file}"
            tar -xzf "${TMP_DIR}/${file}" -C /usr/local/bin doctl
            ;;
        vultr-cli)
            dir="vultr-cli/${ver}"
            file="vultr-cli_v${ver}_linux_amd64.tar.gz"
            base="$(printf '%s/vultr/vultr-cli/releases/download/v%s' "$gh" "$ver")"
            fetch_and_verify "$dir" "$file" "${base}/${file}" "${base}/vultr-cli_v${ver}_checksums.txt" "${TMP_DIR}/${file}"
            tar -xzf "${TMP_DIR}/${file}" -C /usr/local/bin vultr-cli
            ;;
        exo)
            dir="exo/${ver}"
            file="exoscale-cli_${ver}_linux_amd64.tar.gz"
            base="$(printf '%s/exoscale/cli/releases/download/v%s' "$gh" "$ver")"
            fetch_and_verify "$dir" "$file" "${base}/${file}" "" "${TMP_DIR}/${file}"
            tar -xzf "${TMP_DIR}/${file}" -C /usr/local/bin exo
            ;;
        geesefs)
            dir="geesefs/${ver}"
            file="geesefs-linux-amd64"
            base="$(printf '%s/yandex-cloud/geesefs/releases/download/v%s' "$gh" "$ver")"
            fetch_and_verify "$dir" "$file" "${base}/${file}" "" "${TMP_DIR}/${file}"
            cp "${TMP_DIR}/${file}" /usr/local/bin/geesefs
            ;;
        lego)
            dir="lego/${ver}"
            file="lego_v${ver}_linux_amd64.tar.gz"
            base="$(printf '%s/go-acme/lego/releases/download/v%s' "$gh" "$ver")"
            fetch_and_verify "$dir" "$file" "${base}/${file}" "${base}/lego_${ver}_checksums.txt" "${TMP_DIR}/${file}"
            tar -xzf "${TMP_DIR}/${file}" -C /usr/local/bin lego
            ;;
        goofys)
            dir="goofys/${ver}"
            file="goofys"
            url="$(printf '%s/kahing/goofys/releases/download/v%s/goofys' "$gh" "$ver")"
            fetch_and_verify "$dir" "$file" "$url" "" "${TMP_DIR}/${file}"
            cp "${TMP_DIR}/${file}" /usr/local/bin/goofys
            ;;
        acme.sh)
            dir="acme.sh/${ver}"
            file="acme.sh"
            url="$(printf 'https://githubusercontent.com' "$ver")"
            fetch_and_verify "$dir" "$file" "$url" "" "${TMP_DIR}/${file}"
            cp "${TMP_DIR}/${file}" /usr/local/bin/acme.sh
            ;;
        *)
            status "Error: Unknown PINNED tool '${tool}'"
            exit 1
            ;;
    esac

    chmod +x "/usr/local/bin/${tool}"
    seed_datastore "$dir" "${TMP_DIR}/${file}"
}

# Install Python CLI in isolated venv with S3 wheel-bundle pull-through cache (survives PyPI outages)
install_pinned_pip() {
    pkg="$1"
    ver="$2"

    dir="pip/${pkg}/${ver}"
    bundle="${pkg}-${ver}-wheels.tar.gz"
    bundle_path="${TMP_DIR}/${bundle}"
    wheel_dir="${TMP_DIR}/wheels-${pkg}"

    mkdir -p "$wheel_dir"
    python3 -m venv "/opt/${pkg}"

    if pull_file "${dir}/${bundle}" "" "$bundle_path"; then
        status "[DATASTORE HIT] ${dir}/${bundle}"
        tar -xzf "$bundle_path" -C "$wheel_dir"
        "/opt/${pkg}/bin/pip" install --no-index --find-links="$wheel_dir" "${pkg}==${ver}"
    else
        status "[DATASTORE MISS] Downloading wheels for ${pkg}==${ver} from PyPI"
        "/opt/${pkg}/bin/pip" download --dest "$wheel_dir" "${pkg}==${ver}"
        "/opt/${pkg}/bin/pip" install --no-index --find-links="$wheel_dir" "${pkg}==${ver}"

        tar -czf "$bundle_path" -C "$wheel_dir" .
        ARCHIVE_MISS=1
        CHECKSUM_MISS=0
        seed_datastore "$dir" "$bundle_path"
    fi

    ln -sf "/opt/${pkg}/bin/${pkg}" "/usr/local/bin/${pkg}"
}

# 1. Parse manifest, filter by scope, and prioritize DATASTORETOOL first
while IFS=':' read -r type arg1 arg2 scope; do
    case "$type" in
        ""|\#*) continue ;;
    esac

    should_install "$scope" || continue

    case "$type" in
        DATASTORETOOL)
            if [ -n "$arg2" ]; then
                PINNED_LIST="${arg1}:${arg2} $PINNED_LIST"
            fi
            ;;
        SYSTEM)     SYSTEM_PKGS="$SYSTEM_PKGS $arg1" ;;
        PINNED)     PINNED_LIST="$PINNED_LIST ${arg1}:${arg2}" ;;
        PINNED_PIP) PIP_LIST="$PIP_LIST ${arg1}:${arg2}" ;;
        *)
            status "Error: Unknown directive '${type}' in ${MANIFEST}"
            exit 1
            ;;
    esac
done < "$MANIFEST"

# 2. Wait for dpkg/apt locks, ensure nala exists, and batch-install SYSTEM packages
wait_for_apt_lock

if ! command -v nala >/dev/null 2>&1; then
    status "Bootstrapping nala package manager..."
    apt-get update -y
    apt-get install -y nala
fi

nala update
# Ensure core bootstrap utilities exist even if SYSTEM_PKGS is empty
# shellcheck disable=SC2086
nala install -y curl tar unzip ca-certificates psmisc $SYSTEM_PKGS

# 3. Install PINNED binaries (DATASTORETOOL installs & self-caches first, then caches the rest)
for item in $PINNED_LIST; do
    install_pinned_binary "${item%%:*}" "${item#*:}"
done

# 4. Install PINNED_PIP packages (using S3 wheel-bundle pull-through cache)
for item in $PIP_LIST; do
    install_pinned_pip "${item%%:*}" "${item#*:}"
done

status "Software installation completed cleanly for role '${SERVER_ROLE}' (${CLOUDHOST:-unknown})."
Use code with caution.
(Note: psmisc is included in the base nala install line so fuser is always guaranteed present for wait_for_apt_lock() on subsequent runs, and python3-venv is automatically pulled in whenever PINNED_PIP is used if you add SYSTEM:python3-venv::linode to software.dat.)
You now have the complete, hardened software.dat + install_software.sh ready for your testing over the next couple of weeks—whenever you run your first test build and want to inspect the output or tweak anything, just drop back in!

