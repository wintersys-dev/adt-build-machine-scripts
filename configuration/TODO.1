#!/bin/sh
#: Name:        artifact_cache.sh
#: Purpose:     Shared library for config resolution, APT lock safety, S3 pull-through caching, and SHA256 verification.

if [ -z "${BUILD_HOME:-}" ]; then
    if [ -r /home/buildhome.dat ]; then
        BUILD_HOME="$(/bin/cat /home/buildhome.dat)"
    else
        /bin/echo "Application root configuration file missing at /home/buildhome.dat" >&2
        exit 1
    fi
fi

# Resolve separate config repo if /home/confighome.dat exists; fallback to ${BUILD_HOME}/configuration
if [ -z "${CONFIG_HOME:-}" ]; then
    if [ -r /home/confighome.dat ]; then
        CONFIG_HOME="$(/bin/cat /home/confighome.dat)"
    else
        CONFIG_HOME="${BUILD_HOME}/configuration"
    fi
fi

DATASTORE_OPS="${BUILD_HOME}/services/datastore/operations"
GET_SCRIPT="${DATASTORE_OPS}/GetFromDatastore.sh"
PUT_SCRIPT="${DATASTORE_OPS}/PutToDatastore.sh"
MOUNT_SCRIPT="${DATASTORE_OPS}/MountDatastore.sh"
ARTIFACT_BUCKET="${ARTIFACT_BUCKET:-adt-binary-cache}"

if [ -z "${TMP_DIR:-}" ]; then
    TMP_DIR="$(mktemp -d)"
    trap 'rm -rf "$TMP_DIR"' EXIT INT TERM
fi

ARCHIVE_MISS=0
CHECKSUM_MISS=0

status() {
    if [ -x "${BUILD_HOME}/helpers/services/LogStatusMessages.sh" ]; then
        "${BUILD_HOME}/helpers/services/LogStatusMessages.sh" "${1}" "${2:-no}" 2>/dev/null || true
    else
        printf '%s\n' "${1}"
    fi
}

wait_for_apt_lock() {
    attempts=0
    while [ "$attempts" -lt 24 ]; do
        if ! fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 &&
           ! fuser /var/lib/apt/lists/lock >/dev/null 2>&1 &&
           ! fuser /var/cache/apt/archives/lock >/dev/null 2>&1; then
            return 0
        fi
        status "Waiting for dpkg/apt lock to clear before installing system packages..."
        attempts=$((attempts + 1))
        sleep 5
    done
    status "Error: Timed out waiting for dpkg/apt lock after 120 seconds."
    exit 1
}

pull_file() {
    remote_path="$1"
    upstream_url="$2"
    dest="$3"

    if [ -x "$GET_SCRIPT" ]; then
        if "$GET_SCRIPT" "ad-hoc" "$remote_path" "$dest" "$ARTIFACT_BUCKET" >/dev/null 2>&1 && [ -s "$dest" ]; then
            return 0
        fi
    fi

    [ -n "$upstream_url" ] || return 1
    curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 15 "$upstream_url" -o "$dest"
    return 1
}

resolve_expected_sha256() {
    checksum_file="$1"
    target_file="$2"

    awk -v f="$target_file" '
        {
            name = $2
            sub(/^\*/, "", name)
            sub(/^.*\//, "", name)
            if (name == f || NF == 1) {
                print tolower($1)
                exit
            }
        }
    ' "$checksum_file"
}

fetch_and_verify() {
    bucket_dir="$1"
    filename="$2"
    upstream_url="$3"
    checksum_url="$4"
    dest="$5"

    ARCHIVE_MISS=0
    CHECKSUM_MISS=0

    if pull_file "${bucket_dir}/${filename}" "$upstream_url" "$dest"; then
        status "[DATASTORE HIT] ${bucket_dir}/${filename}"
    else
        status "[DATASTORE MISS] Fetched ${bucket_dir}/${filename} from upstream"
        ARCHIVE_MISS=1
    fi

    [ -z "$checksum_url" ] && return 0

    checksum_name="${filename}.sha256"
    checksum_dest="${TMP_DIR}/${checksum_name}"

    if ! pull_file "${bucket_dir}/${checksum_name}" "$checksum_url" "$checksum_dest"; then
        CHECKSUM_MISS=1
    fi

    expected_sha="$(resolve_expected_sha256 "$checksum_dest" "$filename")"
    if [ -z "$expected_sha" ]; then
        status "Error: Could not find SHA256 hash for ${filename} inside ${checksum_url}"
        exit 1
    fi

    actual_sha="$(sha256sum "$dest" | awk '{print $1}')"
    if [ "$actual_sha" != "$expected_sha" ]; then
        status "Error: SHA256 mismatch for ${filename} (expected ${expected_sha}, got ${actual_sha})"
        exit 1
    fi

    status "[SHA256 OK] ${filename}"
}

seed_datastore() {
    bucket_dir="$1"
    archive_file="$2"
    checksum_file="${archive_file}.sha256"

    [ "$ARCHIVE_MISS" -eq 1 ] || [ "$CHECKSUM_MISS" -eq 1 ] || return 0

    if [ -x "$MOUNT_SCRIPT" ]; then
        "$MOUNT_SCRIPT" "ad-hoc" "distributed" "$ARTIFACT_BUCKET" >/dev/null 2>&1 || true
    fi

    if [ "$ARCHIVE_MISS" -eq 1 ] && [ -x "$PUT_SCRIPT" ] && [ -s "$archive_file" ]; then
        "$PUT_SCRIPT" "ad-hoc" "$archive_file" "$bucket_dir" "distributed" "false" "$ARTIFACT_BUCKET" >/dev/null 2>&1 || true
    fi

    if [ "$CHECKSUM_MISS" -eq 1 ] && [ -x "$PUT_SCRIPT" ] && [ -s "$checksum_file" ]; then
        "$PUT_SCRIPT" "ad-hoc" "$checksum_file" "$bucket_dir" "distributed" "false" "$ARTIFACT_BUCKET" >/dev/null 2>&1 || true
    fi
}
