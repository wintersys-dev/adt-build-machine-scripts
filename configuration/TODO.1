#!/bin/sh
#: Name:        install_software.sh
#: Purpose:     Orchestrates selective installation of system packages, pinned binaries, and cached source builds.
#: Author:      Peter Winter
#: Date:        20/11/2026
#: Version:     2.2
#:
#: Usage:       install_software.sh [--dry-run|-n] [server_role] [path-to-manifest.dat]
#:              install_software.sh [-h|--help]
set -eu

DRY_RUN=0
SERVER_ROLE=""
MANIFEST=""

for arg in "$@"; do
    case "$arg" in
        -h|--help)
            /usr/bin/grep '^#:' "$0" | /usr/bin/cut -c 4-
            exit 0
            ;;
        -n|--dry-run)
            DRY_RUN=1
            ;;
        *)
            if [ -z "$SERVER_ROLE" ]; then
                SERVER_ROLE="$arg"
            elif [ -z "$MANIFEST" ]; then
                MANIFEST="$arg"
            else
                printf 'Error: Unexpected argument "%s"\n' "$arg" >&2
                exit 1
            fi
            ;;
    esac
done

if [ -r /home/buildhome.dat ]; then
    BUILD_HOME="$(/bin/cat /home/buildhome.dat)"
else
    /bin/echo "Application root configuration file missing at /home/buildhome.dat" >&2
    exit 1
fi

export BUILD_HOME
. "${BUILD_HOME}/installscripts/lib/artifact_cache.sh"
export CONFIG_HOME

SERVER_ROLE="${SERVER_ROLE:-all}"
MANIFEST="${MANIFEST:-${CONFIG_HOME}/software.dat}"
DRIVERS_DIR="${BUILD_HOME}/installscripts/drivers"

if [ ! -r "$MANIFEST" ]; then
    status "Error: Manifest file missing or unreadable at ${MANIFEST}"
    exit 1
fi

CLOUDHOST="${CLOUDHOST:-$("${BUILD_HOME}/helpers/services/GetVariableValue.sh" CLOUDHOST 2>/dev/null || true)}"

SYSTEM_PKGS=""
DRIVER_LIST=""

should_install() {
    scope_list="$1"
    [ -z "$scope_list" ] && return 0

    old_ifs="$IFS"
    IFS=','
    for token in $scope_list; do
        case "$token" in
            all|"$CLOUDHOST"|"$SERVER_ROLE")
                IFS="$old_ifs"
                return 0
                ;;
        esac
    done
    IFS="$old_ifs"
    return 1
}

# 1. Parse manifest, filter by scope, and prioritize DATASTORETOOL first
while IFS=':' read -r type arg1 arg2 scope; do
    case "$type" in
        ""|\#*) continue ;;
    esac

    should_install "$scope" || continue

    case "$type" in
        DATASTORETOOL)
            if [ -n "$arg2" ]; then
                DRIVER_LIST="${arg1}:${arg2} $DRIVER_LIST"
            else
                SYSTEM_PKGS="$SYSTEM_PKGS $arg1"
            fi
            ;;
        SYSTEM)            SYSTEM_PKGS="$SYSTEM_PKGS $arg1" ;;
        PINNED|PINNED_PIP) DRIVER_LIST="$DRIVER_LIST ${arg1}:${arg2}" ;;
        SOURCE)            DRIVER_LIST="$DRIVER_LIST ${arg1}-source:${arg2}" ;;
        *)
            status "Error: Unknown directive '${type}' in ${MANIFEST}"
            exit 1
            ;;
    esac
done < "$MANIFEST"

# 2. Validate that all matched drivers exist on disk before making any changes
for item in $DRIVER_LIST; do
    tool="${item%%:*}"
    driver="${DRIVERS_DIR}/${tool}.sh"
    if [ ! -f "$driver" ]; then
        status "Error: Missing driver script ${driver} for tool '${tool}'"
        exit 1
    fi
done

# 3. Preview execution plan and exit cleanly if --dry-run was requested
if [ "$DRY_RUN" -eq 1 ]; then
    printf '=== DRY-RUN EXECUTION PLAN ===\n'
    printf 'Config Home: %s\n' "$CONFIG_HOME"
    printf 'Manifest:    %s\n' "$MANIFEST"
    printf 'Cloudhost:   %s\n' "${CLOUDHOST:-<unset>}"
    printf 'Server Role: %s\n\n' "$SERVER_ROLE"

    printf ' SYSTEM PACKAGES (via nala):\n'
    if [ -n "$SYSTEM_PKGS" ]; then
        for pkg in $SYSTEM_PKGS; do
            printf '    - %s\n' "$pkg"
        done
    else
        printf '    (none)\n'
    fi

    printf '\n DRIVERS (in execution order):\n'
    if [ -n "$DRIVER_LIST" ]; then
        for item in $DRIVER_LIST; do
            printf '    - %s (version %s) -> %s/%s.sh\n' \
                "${item%%:*}" "${item#*:}" "$DRIVERS_DIR" "${item%%:*}"
        done
    else
        printf '    (none)\n'
    fi
    exit 0
fi

# 4. Wait for dpkg/apt locks, ensure nala exists, and batch-install SYSTEM packages
wait_for_apt_lock

if ! command -v nala >/dev/null 2>&1; then
    status "Bootstrapping nala package manager..."
    apt-get update -y
    apt-get install -y nala
fi

nala update
# shellcheck disable=SC2086
nala install -y curl tar unzip ca-certificates psmisc $SYSTEM_PKGS

# 5. Execute each matching tool/source driver (DATASTORETOOL runs & self-caches first)
for item in $DRIVER_LIST; do
    tool="${item%%:*}"
    ver="${item#*:}"
    sh "${DRIVERS_DIR}/${tool}.sh" "$ver"
done

status "Software installation completed cleanly for role '${SERVER_ROLE}' (${CLOUDHOST:-unknown})."
Use code with caution.

