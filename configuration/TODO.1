#!/bin/sh
set -eu
ver="${1:?Version required}"
. "${BUILD_HOME}/installscripts/lib/artifact_cache.sh"

pkg="linode-cli"
dir="pip/${pkg}/${ver}"
bundle="${pkg}-${ver}-wheels.tar.gz"
bundle_path="${TMP_DIR}/${bundle}"
wheel_dir="${TMP_DIR}/wheels-${pkg}"

mkdir -p "$wheel_dir"
python3 -m venv "/opt/${pkg}"

if pull_file "${dir}/${bundle}" "" "$bundle_path"; then
    status "[DATASTORE HIT] ${dir}/${bundle}"
    tar -xzf "$bundle_path" -C "$wheel_dir"
    "/opt/${pkg}/bin/pip" install --no-index --find-links="$wheel_dir" "${pkg}==${ver}"
else
    status "[DATASTORE MISS] Downloading wheels for ${pkg}==${ver} from PyPI"
    "/opt/${pkg}/bin/pip" download --dest "$wheel_dir" "${pkg}==${ver}"
    "/opt/${pkg}/bin/pip" install --no-index --find-links="$wheel_dir" "${pkg}==${ver}"

    tar -czf "$bundle_path" -C "$wheel_dir" .
    ARCHIVE_MISS=1
    CHECKSUM_MISS=0
    seed_datastore "$dir" "$bundle_path"
fi

ln -sf "/opt/${pkg}/bin/${pkg}" "/usr/local/bin/${pkg}"
