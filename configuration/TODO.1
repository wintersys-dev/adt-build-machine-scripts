#!/bin/sh
set -eu
ver="${1:?Version required}"
. "${BUILD_HOME}/installscripts/lib/artifact_cache.sh"

default_flags="--prefix=/etc/nginx --sbin-path=/usr/sbin/nginx --conf-path=/etc/nginx/nginx.conf --with-http_ssl_module --with-http_v2_module --with-http_realip_module --with-pcre-jit"
cfg_flags="$(grep '^NGINX:configure-flags:' "${CONFIG_HOME}/deployment.dat" 2>/dev/null | cut -d':' -f3- || true)"
cfg_flags="${cfg_flags:-$default_flags}"

flags_hash="$(printf '%s' "$cfg_flags" | sha256sum | awk '{print substr($1,1,12)}')"
compiled_dir="nginx-compiled/${ver}"
compiled_pkg="nginx-${ver}-${flags_hash}-linux-amd64.tar.gz"
compiled_path="${TMP_DIR}/${compiled_pkg}"

if pull_file "${compiled_dir}/${compiled_pkg}" "" "$compiled_path"; then
    status "[COMPILED CACHE HIT] Unpacking ${compiled_pkg}..."
    tar -xzf "$compiled_path" -C /
    exit 0
fi

status "[COMPILED CACHE MISS] Compiling Nginx ${ver} (flags hash: ${flags_hash})..."
wait_for_apt_lock
nala install -y build-essential libpcre2-dev libssl-dev zlib1g-dev

src_file="nginx-${ver}.tar.gz"
src_url="$(printf 'https://nginx.org' "$src_file")"
fetch_and_verify "nginx-src/${ver}" "$src_file" "$src_url" "" "${TMP_DIR}/${src_file}"

mkdir -p "${TMP_DIR}/build" "${TMP_DIR}/stage"
tar -xzf "${TMP_DIR}/${src_file}" -C "${TMP_DIR}/build"

(
    cd "${TMP_DIR}/build/nginx-${ver}"
    # shellcheck disable=SC2086
    ./configure $cfg_flags
    make -j"$(nproc)"
    make DESTDIR="${TMP_DIR}/stage" install
)

tar -czf "$compiled_path" -C "${TMP_DIR}/stage" .
tar -xzf "$compiled_path" -C /

ARCHIVE_MISS=1
CHECKSUM_MISS=0
seed_datastore "$compiled_dir" "$compiled_path"
status "[COMPILED & CACHED] ${compiled_pkg} seeded to S3."
