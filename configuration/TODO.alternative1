STAGE_DIR="/tmp/adt_lighttpd_$$"; /bin/mkdir -p "${STAGE_DIR}"; trap '/bin/rm -rf "${STAGE_DIR}"' EXIT INT TERM

setup_service() {
    /bin/mkdir -p /var/log/lighttpd /etc/lighttpd/conf-enabled /run/lighttpd; /bin/chown -R www-data:www-data /var/log/lighttpd /run/lighttpd; /bin/ln -sf /usr/sbin/lighttpd /usr/local/bin/lighttpd
    [ ! -f /etc/lighttpd/lighttpd.conf ] && /bin/printf 'server.modules = ( "mod_access", "mod_alias", "mod_compress", "mod_redirect", "mod_rewrite", "mod_fastcgi" )\nserver.document-root = "/var/www/html"\nserver.errorlog = "/var/log/lighttpd/error.log"\nserver.pid-file = "/run/lighttpd/lighttpd.pid"\nserver.username = "www-data"\nserver.groupname = "www-data"\nserver.port = 80\n' > /etc/lighttpd/lighttpd.conf
    if [ ! -f /lib/systemd/system/lighttpd.service ]; then
        /bin/printf '[Unit]\nDescription=Lighttpd\nAfter=network-online.target\n[Service]\nType=simple\nPIDFile=/run/lighttpd/lighttpd.pid\nExecStart=/usr/sbin/lighttpd -D -f /etc/lighttpd/lighttpd.conf\n[Install]\nWantedBy=multi-user.target\n' > /lib/systemd/system/lighttpd.service
