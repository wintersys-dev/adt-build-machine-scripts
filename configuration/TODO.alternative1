. /etc/os-release; ARCH=$(/usr/bin/uname -m); COMPILED_KEY="compiled/apache/${ID}-${VERSION_ID}-${ARCH}-${VERSION}.tar.gz"
STAGE_DIR="/tmp/adt_apache_$$"; /bin/mkdir -p "${STAGE_DIR}"; trap '/bin/rm -rf "${STAGE_DIR}"' EXIT INT TERM

setup_service() {
    /bin/mkdir -p /var/log/apache2 /etc/apache2/sites-enabled /etc/apache2/conf-enabled /run/apache2; /bin/chown -R www-data:www-data /var/log/apache2 /run/apache2
    /bin/ln -sf /usr/local/apache2/bin/httpd /usr/local/bin/httpd; /bin/ln -sf /usr/local/apache2/bin/apachectl /usr/local/bin/apachectl
    if [ ! -f /lib/systemd/system/apache2.service ]; then
