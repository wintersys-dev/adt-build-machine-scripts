/usr/bin/make -j"$(/usr/bin/nproc 2>/dev/null || /bin/echo 2)" && /usr/bin/make install && setup_service
/bin/tar -czf "${STAGE_DIR}/lighttpd-compiled.tar.gz" /usr/sbin/lighttpd /usr/lib/lighttpd /etc/lighttpd && s3_cache_push "${STAGE_DIR}/lighttpd-compiled.tar.gz" "${COMPILED_KEY}"
