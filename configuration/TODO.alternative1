/usr/bin/make -j"$(/usr/bin/nproc 2>/dev/null || /bin/echo 2)" && /usr/bin/make install
[ -f /etc/apache2/httpd.conf ] && { /usr/bin/sed -i 's|^User daemon|User www-data|g; s|^Group daemon|Group www-data|g' /etc/apache2/httpd.conf; /bin/grep -q '^PidFile ' /etc/apache2/httpd.conf || /bin/echo 'PidFile /run/apache2/httpd.pid' >> /etc/apache2/httpd.conf; }
setup_service && /bin/tar -czf "${STAGE_DIR}/apache-compiled.tar.gz" /usr/local/apache2 /etc/apache2 && s3_cache_push "${STAGE_DIR}/apache-compiled.tar.gz" "${COMPILED_KEY}"
