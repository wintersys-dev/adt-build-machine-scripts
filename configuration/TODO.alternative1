8. Remaining Recipes (php, mariadb, s3mount, linode-cli, acme, composer, wpcli, awscli) & Permissions

sh
RECIPE_DIR="${BUILD_HOME}/installscripts/strategies/recipes"

/bin/cat <<'EOF' > "${RECIPE_DIR}/php.sh"
#!/bin/sh
set -eu
SOURCE_SPEC="${2:-mysqli:curl:gd:zip}"
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
[ ! -d "${BUILD_HOME}/installscripts" ] && [ -d "${HOME}/installscripts" ] && BUILD_HOME="${HOME}"
. "${BUILD_HOME}/installscripts/strategies/lib_pkg.sh"
EXTENSIONS_PART=$(/bin/echo "${SOURCE_SPEC}" | /usr/bin/awk -F'|' '{print $1}'); LISTEN_PORT=$(/bin/echo "${SOURCE_SPEC}" | /usr/bin/awk -F'|' '{print $2}')
pkg_update && pkg_install php-fpm php-cli
OLD_IFS="${IFS}"; IFS=':'; for ext in ${EXTENSIONS_PART}; do [ -n "${ext}" ] && pkg_install "php-${ext}"; done; IFS="${OLD_IFS}"
POOL_CONF=$(/usr/bin/find /etc/php -name "www.conf" | /usr/bin/head -n 1)
[ -n "${LISTEN_PORT}" ] && [ -f "${POOL_CONF}" ] && /usr/bin/sed -i "s|^listen = .*|listen = 127.0.0.1:${LISTEN_PORT}|g" "${POOL_CONF}"
PHP_FPM_SVC=$(/usr/bin/systemctl list-unit-files | /usr/bin/awk '/php.*fpm\.service/ {print $1; exit}')
[ -n "${PHP_FPM_SVC}" ] && { /bin/systemctl enable "${PHP_FPM_SVC}"; /bin/systemctl restart "${PHP_FPM_SVC}"; }
EOF

