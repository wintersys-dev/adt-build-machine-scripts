2. Shared Libraries (lib_pkg.sh & lib_s3_cache.sh)


strategies/lib_pkg.sh

sh
/bin/cat <<'EOF' > "${BUILD_HOME}/installscripts/strategies/lib_pkg.sh"
#!/bin/sh
pkg_update() {
    if command -v nala >/dev/null 2>&1; then
        DEBIAN_FRONTEND=noninteractive /usr/bin/nala update >/dev/null 2>&1 || \
        DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get -o DPkg::Lock::Timeout=-1 -qq -y update
    else
        DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get -o DPkg::Lock::Timeout=-1 -qq -y update
    fi
}
pkg_install() {
    if command -v nala >/dev/null 2>&1; then
        DEBIAN_FRONTEND=noninteractive /usr/bin/nala install --assume-yes --no-install-recommends --simple "$@"
    else
        DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get -o DPkg::Lock::Timeout=-1 -qq -y install --no-install-recommends "$@"
    fi
}
EOF
Use code with caution.

strategies/lib_s3_cache.sh (Part A: Setup & Exists)

sh
/bin/cat <<'EOF' > "${BUILD_HOME}/installscripts/strategies/lib_s3_cache.sh"
#!/bin/sh
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
DATASTORE_DIR="${BUILD_HOME}/providerscripts/datastore"
[ ! -d "${DATASTORE_DIR}" ] && [ -d "${HOME}/providerscripts/datastore" ] && DATASTORE_DIR="${HOME}/providerscripts/datastore"

ADT_CACHE_BUCKET="${ADT_CACHE_BUCKET:-}"
[ -z "${ADT_CACHE_BUCKET}" ] && [ -f "${HOME}/runtime/DATASTORE_BUCKET" ] && ADT_CACHE_BUCKET="`/bin/cat "${HOME}/runtime/DATASTORE_BUCKET"`"
ADT_CACHE_ROOT="adt-artifacts"
ADT_DATASTORE_MOUNTED=0

ensure_datastore_ready() {
    [ -z "${ADT_CACHE_BUCKET}" ] || [ ! -x "${DATASTORE_DIR}/MountDatastore.sh" ] && return 1
    if [ "${ADT_DATASTORE_MOUNTED}" -eq 0 ]; then
        /bin/sh "${DATASTORE_DIR}/MountDatastore.sh" "${ADT_CACHE_BUCKET}" >/dev/null 2>&1 || return 1
        ADT_DATASTORE_MOUNTED=1
    fi
    return 0
}

s3_cache_exists() {
    CACHE_KEY="$1"
    ensure_datastore_ready || return 1
    if [ -x "${DATASTORE_DIR}/ListFromDatastore.sh" ]; then
        REMOTE_PATH="${ADT_CACHE_BUCKET}/${ADT_CACHE_ROOT}/${CACHE_KEY}"
        /bin/sh "${DATASTORE_DIR}/ListFromDatastore.sh" "${REMOTE_PATH}" 2>/dev/null | /usr/bin/grep -Fq "$(/usr/bin/basename "${CACHE_KEY}")" && return 0
    fi
    return 1
}
EOF
Use code with caution.

strategies/lib_s3_cache.sh (Part B: Pull, Push, List, Delete, Fetch)

sh
/bin/cat <<'EOF' >> "${BUILD_HOME}/installscripts/strategies/lib_s3_cache.sh"
s3_cache_pull() {
    CACHE_KEY="$1"; DEST_FILE="$2"
    ensure_datastore_ready || return 1
    [ ! -x "${DATASTORE_DIR}/GetFromDatastore.sh" ] && return 1
    REMOTE_PATH="${ADT_CACHE_BUCKET}/${ADT_CACHE_ROOT}/${CACHE_KEY}"
    DEST_DIR=$(/usr/bin/dirname "${DEST_FILE}"); DEST_NAME=$(/usr/bin/basename "${DEST_FILE}"); REMOTE_NAME=$(/usr/bin/basename "${CACHE_KEY}")
    if /bin/sh "${DATASTORE_DIR}/GetFromDatastore.sh" "${REMOTE_PATH}" "${DEST_DIR}" >/dev/null 2>&1 && [ -f "${DEST_DIR}/${REMOTE_NAME}" ]; then
        [ "${REMOTE_NAME}" != "${DEST_NAME}" ] && /bin/mv -f "${DEST_DIR}/${REMOTE_NAME}" "${DEST_FILE}"
        return 0
    fi
    return 1
}

s3_cache_push() {
    SRC_FILE="$1"; CACHE_KEY="$2"
    [ ! -f "${SRC_FILE}" ] && return 0
    ensure_datastore_ready || return 0
    [ ! -x "${DATASTORE_DIR}/PutToDatastore.sh" ] && return 0
    /bin/sh "${DATASTORE_DIR}/PutToDatastore.sh" "${SRC_FILE}" "${ADT_CACHE_BUCKET}/${ADT_CACHE_ROOT}/$(/usr/bin/dirname "${CACHE_KEY}")" >/dev/null 2>&1 || true
}

s3_cache_list() {
    ensure_datastore_ready || return 1
    [ ! -x "${DATASTORE_DIR}/ListFromDatastore.sh" ] && return 1
    /bin/sh "${DATASTORE_DIR}/ListFromDatastore.sh" "${ADT_CACHE_BUCKET}/${ADT_CACHE_ROOT}" 2>/dev/null || return 1
}

s3_cache_delete() {
    ensure_datastore_ready || return 1
    [ ! -x "${DATASTORE_DIR}/DeleteFromDatastore.sh" ] && return 1
    /bin/sh "${DATASTORE_DIR}/DeleteFromDatastore.sh" "${ADT_CACHE_BUCKET}/${ADT_CACHE_ROOT}/$1" >/dev/null 2>&1
}

cached_fetch() {
    TOOL_ID="$1"; TOOL_VER="$2"; UPSTREAM_URL="$3"; EXPECTED_SHA="$4"; OUT_FILE="$5"
    FILENAME=$(/usr/bin/basename "${UPSTREAM_URL%%\?*}"); CACHE_KEY="${TOOL_ID}/${TOOL_VER}/${FILENAME}"; FROM_CACHE=0
    if s3_cache_pull "${CACHE_KEY}" "${OUT_FILE}"; then
        /bin/echo "[ADT-CACHE] HIT: ${CACHE_KEY}"; FROM_CACHE=1
    else
        /bin/echo "[ADT-CACHE] MISS: ${UPSTREAM_URL}"; /usr/bin/curl -fsSL --retry 3 "${UPSTREAM_URL}" -o "${OUT_FILE}"
    fi
    if [ "${EXPECTED_SHA}" != "skip" ] && [ -n "${EXPECTED_SHA}" ]; then
        ACTUAL_SHA=$(/usr/bin/sha256sum "${OUT_FILE}" | /usr/bin/awk '{print $1}')
        [ "${ACTUAL_SHA}" != "${EXPECTED_SHA}" ] && { /bin/echo "[ERROR] SHA256 mismatch for ${TOOL_ID}!" >&2; /bin/rm -f "${OUT_FILE}"; return 1; }
    fi
    [ "${FROM_CACHE}" -eq 0 ] && { /bin/echo "[ADT-CACHE] POPULATE: ${CACHE_KEY}"; s3_cache_push "${OUT_FILE}" "${CACHE_KEY}"; }
}
EOF
Use code with caution.

3. Strategy Handlers (install_repo, install_binary, install_source, install_custom)

sh
/bin/cat <<'EOF' > "${BUILD_HOME}/installscripts/strategies/install_repo.sh"
#!/bin/sh
set -eu
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
[ ! -d "${BUILD_HOME}/installscripts" ] && [ -d "${HOME}/installscripts" ] && BUILD_HOME="${HOME}"
. "${BUILD_HOME}/installscripts/strategies/lib_pkg.sh"
pkg_update && pkg_install $1
EOF

/bin/cat <<'EOF' > "${BUILD_HOME}/installscripts/strategies/install_binary.sh"
#!/bin/sh
set -eu
ID="$1"; VERSION="$2"; URL="$3"; EXPECTED_SHA256="$4"; BIN_NAME="$5"
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
[ ! -d "${BUILD_HOME}/installscripts" ] && [ -d "${HOME}/installscripts" ] && BUILD_HOME="${HOME}"
. "${BUILD_HOME}/installscripts/strategies/lib_s3_cache.sh"
STAGE_DIR="/tmp/adt_stage_${ID}_$$"; /bin/mkdir -p "${STAGE_DIR}"
trap '/bin/rm -rf "${STAGE_DIR}"' EXIT INT TERM
ARCHIVE="${STAGE_DIR}/download"
cached_fetch "${ID}" "${VERSION}" "${URL}" "${EXPECTED_SHA256}" "${ARCHIVE}"
case "${URL}" in
    *.tar.gz|*.tgz) /bin/tar -xzf "${ARCHIVE}" -C "${STAGE_DIR}" ;;
    *.tar.xz)       /bin/tar -xJf "${ARCHIVE}" -C "${STAGE_DIR}" ;;
    *.zip)          /usr/bin/unzip -q "${ARCHIVE}" -d "${STAGE_DIR}" ;;
    *)              /bin/mv "${ARCHIVE}" "${STAGE_DIR}/${BIN_NAME}" ;;
esac
FOUND_BIN=$(/usr/bin/find "${STAGE_DIR}" -type f -name "${BIN_NAME}" | /usr/bin/head -n 1)
[ -z "${FOUND_BIN}" ] && { /bin/echo "[ERROR] Binary '${BIN_NAME}' not found" >&2; exit 1; }
/bin/chmod 0755 "${FOUND_BIN}" && /bin/mv -f "${FOUND_BIN}" "/usr/local/bin/${BIN_NAME}"
EOF

/bin/cat <<'EOF' > "${BUILD_HOME}/installscripts/strategies/install_source.sh"
#!/bin/sh
set -eu
ID="$1"; VERSION="$2"; URL="$3"; EXPECTED_SHA256="$4"
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
[ ! -d "${BUILD_HOME}/installscripts" ] && [ -d "${HOME}/installscripts" ] && BUILD_HOME="${HOME}"
. "${BUILD_HOME}/installscripts/strategies/lib_s3_cache.sh"
SRC_DIR="/tmp/adt_src_${ID}_$$"; /bin/mkdir -p "${SRC_DIR}"
trap '/bin/rm -rf "${SRC_DIR}"' EXIT INT TERM
cached_fetch "${ID}" "${VERSION}" "${URL}" "${EXPECTED_SHA256}" "${SRC_DIR}/source.tar.gz"
/bin/tar -xzf "${SRC_DIR}/source.tar.gz" -C "${SRC_DIR}" --strip-components=1
cd "${SRC_DIR}" && /bin/sh "${BUILD_HOME}/installscripts/strategies/recipes/${ID}.sh" "${VERSION}"
EOF

/bin/cat <<'EOF' > "${BUILD_HOME}/installscripts/strategies/install_custom.sh"
#!/bin/sh
set -eu
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
[ ! -d "${BUILD_HOME}/installscripts" ] && [ -d "${HOME}/installscripts" ] && BUILD_HOME="${HOME}"
/bin/sh "${BUILD_HOME}/installscripts/strategies/recipes/$1.sh" "$2" "$3" "$4" "$5"
EOF
Use code with caution.

4. Core Engine (InstallEngine.sh)

sh
/bin/cat <<'EOF' > "${BUILD_HOME}/installscripts/InstallEngine.sh"
#!/bin/sh
set -eu
ROLE="${1:-}"
[ -z "${ROLE}" ] && { /bin/echo "Usage: $0 <build|web|auto|db>" >&2; exit 1; }
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
[ ! -d "${BUILD_HOME}/installscripts" ] && [ -d "${HOME}/installscripts" ] && BUILD_HOME="${HOME}"
MANIFEST="${BUILD_HOME}/configuration/packages.manifest"
STRATEGY_DIR="${BUILD_HOME}/installscripts/strategies"
STATE_DIR="${HOME}/runtime/installedsoftware"
/bin/mkdir -p "${STATE_DIR}"
. "${STRATEGY_DIR}/lib_pkg.sh"
trim() { /bin/echo "$1" | /usr/bin/sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

HAS_NALA=$(/usr/bin/awk -F'|' -v role="${ROLE}" '$0 !~ /^[[:space:]]*#/ && $0 !~ /^[[:space:]]*$/ { gsub(/[[:space:]]/, "", $1); gsub(/[[:space:]]/, "", $2); if ($1 == "nala" && ("," $2 "," ~ "," role ",")) print "yes" }' "${MANIFEST}")
[ "${HAS_NALA}" = "yes" ] && ! command -v nala >/dev/null 2>&1 && { pkg_update && pkg_install nala; }

REPO_PKGS=$(/usr/bin/awk -F'|' -v role="${ROLE}" '$0 !~ /^[[:space:]]*#/ && $0 !~ /^[[:space:]]*$/ { gsub(/[[:space:]]/, "", $1); gsub(/[[:space:]]/, "", $2); gsub(/[[:space:]]/, "", $3); gsub(/^[[:space:]]+|[[:space:]]+$/, "", $5); if ($1 != "nala" && ("," $2 "," ~ "," role ",") && $3 == "repo") printf "%s ", $5 }' "${MANIFEST}")
[ -n "${REPO_PKGS}" ] && /bin/sh "${STRATEGY_DIR}/install_repo.sh" "${REPO_PKGS}"

ROWS_FILE="/tmp/adt_engine_rows_$$"; trap '/bin/rm -f "${ROWS_FILE}"' EXIT INT TERM
/usr/bin/awk -F'|' -v role="${ROLE}" '$0 !~ /^[[:space:]]*#/ && $0 !~ /^[[:space:]]*$/ { gsub(/[[:space:]]/, "", $2); gsub(/[[:space:]]/, "", $3); if (("," $2 "," ~ "," role ",") && $3 != "repo") print $0 }' "${MANIFEST}" > "${ROWS_FILE}"

while IFS='|' read -r raw_id raw_roles raw_method raw_ver raw_src raw_sha raw_bin; do
    ID=$(trim "${raw_id}"); METHOD=$(trim "${raw_method}"); VERSION=$(trim "${raw_ver}")
    SOURCE=$(trim "${raw_src}"); SHA256=$(trim "${raw_sha}"); BIN_NAME=$(trim "${raw_bin:-$ID}")
    STATE_FILE="${STATE_DIR}/${ID}.state"
    if [ -f "${STATE_FILE}" ] && [ "`/bin/cat "${STATE_FILE}"`" = "${VERSION}" ]; then
        if [ -x "/usr/local/bin/${BIN_NAME}" ] || [ -x "/usr/bin/${BIN_NAME}" ] || [ -x "/usr/sbin/${BIN_NAME}" ]; then continue; fi
    fi
    /bin/echo "[ADT-INSTALL] Installing ${ID} (${VERSION}) via ${METHOD}..."
    /bin/sh "${STRATEGY_DIR}/install_${METHOD}.sh" "${ID}" "${VERSION}" "${SOURCE}" "${SHA256}" "${BIN_NAME}"
    /bin/echo "${VERSION}" > "${STATE_FILE}"
done < "${ROWS_FILE}"
EOF
Use code with caution.

5. Pre-Builder & Cache Verifier (BuildAllArtifacts.sh & VerifyCache.sh)


BuildAllArtifacts.sh

sh
/bin/cat <<'EOF' > "${BUILD_HOME}/installscripts/BuildAllArtifacts.sh"
#!/bin/sh
set -eu
TARGET_ROLES="build,web,auto,db"; FORCE_REBUILD=0
for arg in "$@"; do case "${arg}" in --force) FORCE_REBUILD=1 ;; *) TARGET_ROLES="${arg}" ;; esac; done
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
MANIFEST="${BUILD_HOME}/configuration/packages.manifest"; STRATEGY_DIR="${BUILD_HOME}/installscripts/strategies"
. "${STRATEGY_DIR}/lib_s3_cache.sh"; . "${STRATEGY_DIR}/lib_pkg.sh"
[ -z "${ADT_CACHE_BUCKET}" ] && { /bin/echo "[ERROR] ADT_CACHE_BUCKET not set." >&2; exit 1; }
trim() { /bin/echo "$1" | /usr/bin/sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

/bin/sh "${BUILD_HOME}/installscripts/InstallEngine.sh" "build"
. /etc/os-release; ARCH=$(/usr/bin/uname -m)
STAGE_DIR="/tmp/adt_prewarm_$$"; ROWS_FILE="/tmp/adt_prewarm_rows_$$"; /bin/mkdir -p "${STAGE_DIR}"
trap '/bin/rm -rf "${STAGE_DIR}" "${ROWS_FILE}"' EXIT INT TERM

seed_if_missing() {
    S_ID="$1"; S_VER="$2"; S_URL="$3"; S_SHA="$4"; S_OUT="$5"
    CACHE_KEY="${S_ID}/${S_VER}/$(/usr/bin/basename "${S_URL%%\?*}")"
    [ "${FORCE_REBUILD}" -eq 0 ] && s3_cache_exists "${CACHE_KEY}" && { /bin/echo "[SKIP] Cached: ${CACHE_KEY}"; return 0; }
    /bin/rm -f "${S_OUT}"
    if [ "${FORCE_REBUILD}" -eq 1 ]; then /usr/bin/curl -fsSL --retry 3 "${S_URL}" -o "${S_OUT}"; s3_cache_push "${S_OUT}" "${CACHE_KEY}"
    else cached_fetch "${S_ID}" "${S_VER}" "${S_URL}" "${S_SHA}" "${S_OUT}"; fi
}

/usr/bin/awk -F'|' '$0 !~ /^[[:space:]]*#/ && $0 !~ /^[[:space:]]*$/ { gsub(/[[:space:]]/, "", $3); if ($3 != "repo") print $0 }' "${MANIFEST}" > "${ROWS_FILE}"
while IFS='|' read -r raw_id raw_roles raw_method raw_ver raw_src raw_sha raw_bin; do
    ID=$(trim "${raw_id}"); ROLES=$(trim "${raw_roles}" | /usr/bin/tr -d ' ')
    METHOD=$(trim "${raw_method}"); VERSION=$(trim "${raw_ver}"); SOURCE=$(trim "${raw_src}"); SHA256=$(trim "${raw_sha}"); BIN_NAME=$(trim "${raw_bin:-$ID}")
    MATCHED=0; OLD_IFS="${IFS}"; IFS=','; for r in ${TARGET_ROLES}; do case ",${ROLES}," in *,"${r}",*) MATCHED=1; break ;; esac; done; IFS="${OLD_IFS}"
    [ "${MATCHED}" -eq 0 ] && continue
    case "${ID}" in
        nginx|apache|lighttpd)
            COMPILED_KEY="compiled/${ID}/${ID}-${VERSION_ID}-${ARCH}-${VERSION}.tar.gz"
            [ "${FORCE_REBUILD}" -eq 0 ] && s3_cache_exists "${COMPILED_KEY}" && { /bin/echo "[SKIP] Cached: ${COMPILED_KEY}"; continue; }
            [ "${FORCE_REBUILD}" -eq 1 ] && s3_cache_delete "${COMPILED_KEY}" || true
            /bin/sh "${STRATEGY_DIR}/recipes/${ID}.sh" "${VERSION}" "${SOURCE}" "${SHA256}" "${BIN_NAME}"
            SVC_NAME="${ID}"; [ "${ID}" = "apache" ] && SVC_NAME="apache2"
            /bin/systemctl stop "${SVC_NAME}" >/dev/null 2>&1 || true; /bin/systemctl disable "${SVC_NAME}" >/dev/null 2>&1 || true ;;
        wpcli) URL="${SOURCE}"; [ "${VERSION}" != "latest" ] && URL="https://github.com{VERSION}/wp-cli-${VERSION}.phar"; seed_if_missing "wpcli" "${VERSION}" "${URL}" "${SHA256}" "${STAGE_DIR}/${BIN_NAME}" ;;
        awscli) URL="${SOURCE}"; [ "${VERSION}" != "latest" ] && URL="https://amazonaws.com{VERSION}.zip"; seed_if_missing "awscli" "${VERSION}" "${URL}" "${SHA256}" "${STAGE_DIR}/awscliv2.zip" ;;
        goofys|geesefs) seed_if_missing "${BIN_NAME}" "${VERSION}" "${SOURCE}" "${SHA256}" "${STAGE_DIR}/${BIN_NAME}" ;;
        *) case "${SOURCE}" in http://*|https://*) [ "${METHOD}" = "binary" ] || [ "${METHOD}" = "source" ] && seed_if_missing "${ID}" "${VERSION}" "${SOURCE}" "${SHA256}" "${STAGE_DIR}/${ID}_pkg" ;; esac ;;
    esac
done < "${ROWS_FILE}"
EOF
Use code with caution.

VerifyCache.sh

sh
/bin/cat <<'EOF' > "${BUILD_HOME}/installscripts/VerifyCache.sh"
#!/bin/sh
set -eu
TARGET_ROLES="${1:-build,web,auto,db}"
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
MANIFEST="${BUILD_HOME}/configuration/packages.manifest"
. "${BUILD_HOME}/installscripts/strategies/lib_s3_cache.sh"
[ -z "${ADT_CACHE_BUCKET}" ] && { /bin/echo "[ERROR] ADT_CACHE_BUCKET not set." >&2; exit 1; }
trim() { /bin/echo "$1" | /usr/bin/sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }
. /etc/os-release; ARCH=$(/usr/bin/uname -m)

CACHED_LIST=$(s3_cache_list || true)
[ -z "${CACHED_LIST}" ] && { /bin/echo "[FAIL] S3 cache is empty!" >&2; exit 1; }
MISSING=0; CHECKED=0; ROWS_FILE="/tmp/adt_verify_cache_rows_$$"; trap '/bin/rm -f "${ROWS_FILE}"' EXIT INT TERM
check_pattern() { CHECKED=$((CHECKED + 1)); if /bin/echo "${CACHED_LIST}" | /usr/bin/grep -Eq "$2"; then /bin/echo "[OK] $1"; else /bin/echo "[MISSING] $1" >&2; MISSING=$((MISSING + 1)); fi; }

/usr/bin/awk -F'|' '$0 !~ /^[[:space:]]*#/ && $0 !~ /^[[:space:]]*$/ { gsub(/[[:space:]]/, "", $3); if ($3 != "repo") print $0 }' "${MANIFEST}" > "${ROWS_FILE}"
while IFS='|' read -r raw_id raw_roles raw_method raw_ver raw_src raw_sha raw_bin; do
    ID=$(trim "${raw_id}"); ROLES=$(trim "${raw_roles}" | /usr/bin/tr -d ' '); METHOD=$(trim "${raw_method}"); VERSION=$(trim "${raw_ver}"); SOURCE=$(trim "${raw_src}"); BIN_NAME=$(trim "${raw_bin:-$ID}")
    MATCHED=0; OLD_IFS="${IFS}"; IFS=','; for r in ${TARGET_ROLES}; do case ",${ROLES}," in *,"${r}",*) MATCHED=1; break ;; esac; done; IFS="${OLD_IFS}"
    [ "${MATCHED}" -eq 0 ] && continue
    case "${ID}" in
        nginx|apache|lighttpd) check_pattern "${ID} (${VERSION})" "compiled/${ID}/${ID}-${VERSION_ID}-${ARCH}-${VERSION}\.tar\.gz" ;;
        wpcli) check_pattern "wpcli (${VERSION})" "wpcli/${VERSION}/wp-cli" ;;
        awscli) check_pattern "awscli (${VERSION})" "awscli/${VERSION}/awscli-exe-" ;;
        goofys|geesefs) check_pattern "${BIN_NAME} (${VERSION})" "${BIN_NAME}/${VERSION}/" ;;
        *) case "${SOURCE}" in http://*|https://*) [ "${METHOD}" = "binary" ] || [ "${METHOD}" = "source" ] && check_pattern "${ID} (${VERSION})" "${ID}/${VERSION}/$(/usr/bin/basename "${SOURCE%%\?*}")" ;; esac ;;
    esac
done < "${ROWS_FILE}"
[ "${MISSING}" -gt 0 ] && exit 1
/bin/echo "[PASSED] All ${CHECKED} artifact(s) present in S3 cache."
EOF
Use code with caution.

6. Validator & Pruner (VerifyManifest.sh & PruneArtifactCache.sh)


VerifyManifest.sh

sh
/bin/cat <<'EOF' > "${BUILD_HOME}/installscripts/VerifyManifest.sh"
#!/bin/sh
set -eu
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
MANIFEST="${BUILD_HOME}/configuration/packages.manifest"; RECIPE_DIR="${BUILD_HOME}/installscripts/strategies/recipes"
trim() { /bin/echo "$1" | /usr/bin/sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }
ERRORS=0; LINE_NUM=0
while IFS= read -r line || [ -n "${line}" ]; do
    LINE_NUM=$((LINE_NUM + 1))
    case "${line}" in ""|\#*) continue ;; esac
    PIPE_COUNT=$(/bin/echo "${line}" | /usr/bin/tr -cd '|' | /usr/bin/wc -c)
    [ "${PIPE_COUNT}" -ne 6 ] && { /bin/echo "[FAIL] Line ${LINE_NUM}: Expected 7 columns" >&2; ERRORS=$((ERRORS + 1)); continue; }
    IFS='|' read -r raw_id raw_roles raw_method raw_ver raw_src raw_sha raw_bin <<ROW
${line}
ROW
    ID=$(trim "${raw_id}"); METHOD=$(trim "${raw_method}"); SOURCE=$(trim "${raw_src}")
    case "${METHOD}" in
        repo) [ -z "${SOURCE}" ] && ERRORS=$((ERRORS + 1)) ;;
        binary|source)
            /usr/bin/curl -fsIL --max-time 10 "${SOURCE}" >/dev/null 2>&1 || { /bin/echo "[FAIL] ${ID}: Unreachable URL" >&2; ERRORS=$((ERRORS + 1)); }
            [ "${METHOD}" = "source" ] && [ ! -f "${RECIPE_DIR}/${ID}.sh" ] && ERRORS=$((ERRORS + 1)) ;;
        custom) [ ! -f "${RECIPE_DIR}/${ID}.sh" ] && { /bin/echo "[FAIL] ${ID}: Missing recipe" >&2; ERRORS=$((ERRORS + 1)); } ;;
        *) ERRORS=$((ERRORS + 1)) ;;
    esac
done < "${MANIFEST}"
[ "${ERRORS}" -gt 0 ] && exit 1
/bin/echo "[ADT-VERIFY] Manifest valid."
EOF
Use code with caution.

PruneArtifactCache.sh

sh
/bin/cat <<'EOF' > "${BUILD_HOME}/installscripts/PruneArtifactCache.sh"
#!/bin/sh
set -eu
DRY_RUN="${1:-}"
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
MANIFEST="${BUILD_HOME}/configuration/packages.manifest"
. "${BUILD_HOME}/installscripts/strategies/lib_s3_cache.sh"
trim() { /bin/echo "$1" | /usr/bin/sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

ACTIVE_KEYS_FILE="/tmp/adt_active_keys_$$"; trap '/bin/rm -f "${ACTIVE_KEYS_FILE}"' EXIT INT TERM; : > "${ACTIVE_KEYS_FILE}"
while IFS= read -r line || [ -n "${line}" ]; do
    case "${line}" in ""|\#*) continue ;; esac
    IFS='|' read -r raw_id raw_roles raw_method raw_ver raw_src raw_sha raw_bin <<ROW
${line}
ROW
    ID=$(trim "${raw_id}"); METHOD=$(trim "${raw_method}"); VERSION=$(trim "${raw_ver}")
    [ "${METHOD}" = "repo" ] && continue
    /bin/echo "${ID}/${VERSION}/" >> "${ACTIVE_KEYS_FILE}"
    /bin/echo "compiled/${ID}/.*-${VERSION}\.tar\.gz$" >> "${ACTIVE_KEYS_FILE}"
    case "${ID}" in nginx|apache|lighttpd) /bin/echo "${ID}-src/${VERSION}/" >> "${ACTIVE_KEYS_FILE}" ;; esac
done < "${MANIFEST}"

CACHED_OBJECTS=$(s3_cache_list || true)
[ -z "${CACHED_OBJECTS}" ] && exit 0
/bin/echo "${CACHED_OBJECTS}" | while IFS= read -r raw_obj; do
    REL_KEY=$(/bin/echo "${raw_obj}" | /usr/bin/sed -E "s|^.*${ADT_CACHE_ROOT}/||")
    [ -z "${REL_KEY}" ] || [ "${REL_KEY}" = "${raw_obj}" ] && continue
    IS_ACTIVE=0
    while IFS= read -r pattern; do [ -n "${pattern}" ] && /bin/echo "${REL_KEY}" | /usr/bin/grep -Eq "^${pattern}" && { IS_ACTIVE=1; break; }; done < "${ACTIVE_KEYS_FILE}"
    [ "${IS_ACTIVE}" -eq 1 ] && continue
    if [ "${DRY_RUN}" = "--dry-run" ]; then /bin/echo "[DRY-RUN] Delete: ${REL_KEY}"; else s3_cache_delete "${REL_KEY}"; fi
done
EOF
Use code with caution.

7. Webserver Recipes (nginx.sh, apache.sh, lighttpd.sh)


strategies/recipes/nginx.sh

sh
/bin/cat <<'EOF' > "${BUILD_HOME}/installscripts/strategies/recipes/nginx.sh"
#!/bin/sh
set -eu
VERSION="${1:-1.27.3}"; SOURCE_URL="${2:-https://nginx.org{VERSION}.tar.gz}"; EXPECTED_SHA256="${3:-skip}"
BUILD_HOME="`/bin/cat /home/buildhome.dat 2>/dev/null || /bin/echo ${HOME}/adt-build-machine-scripts`"
[ ! -d "${BUILD_HOME}/installscripts" ] && [ -d "${HOME}/installscripts" ] && BUILD_HOME="${HOME}"
. "${BUILD_HOME}/installscripts/strategies/lib_s3_cache.sh"; . "${BUILD_HOME}/installscripts/strategies/lib_pkg.sh"
. /etc/os-release; ARCH=$(/usr/bin/uname -m); COMPILED_KEY="compiled/nginx/${ID}-${VERSION_ID}-${ARCH}-${VERSION}.tar.gz"
STAGE_DIR="/tmp/adt_nginx_$$"; /bin/mkdir -p "${STAGE_DIR}"; trap '/bin/rm -rf "${STAGE_DIR}"' EXIT INT TERM

setup_service() {
    /bin/mkdir -p /var/log/nginx /etc/nginx/conf.d /etc/nginx/sites-enabled; /bin/chown -R www-data:www-data /var/log/nginx; /bin/ln -sf /usr/sbin/nginx /usr/local/bin/nginx
    if [ ! -f /lib/systemd/system/nginx.service ]; then
        /bin/printf '[Unit]\nDescription=NGINX\nAfter=network-online.target\n[Service]\nType=forking\nPIDFile=/run/nginx.pid\nExecStart=/usr/sbin/nginx\nExecReload=/usr/sbin/nginx -s reload\n[Install]\nWantedBy=multi-user.target\n' > /lib/systemd/system/nginx.service
        /bin/systemctl daemon-reload && /bin/systemctl enable nginx
    fi
}
if s3_cache_pull "${COMPILED_KEY}" "${STAGE_DIR}/nginx-compiled.tar.gz"; then
    pkg_update && pkg_install libpcre2-8-0 zlib1g libssl3; /bin/tar -xzf "${STAGE_DIR}/nginx-compiled.tar.gz" -C /; setup_service && exit 0
fi
pkg_update && pkg_install build-essential libpcre2-dev zlib1g-dev libssl-dev
cached_fetch "nginx-src" "${VERSION}" "${SOURCE_URL}" "${EXPECTED_SHA256}" "${STAGE_DIR}/nginx.tar.gz"
/bin/mkdir -p "${STAGE_DIR}/src" && /bin/tar -xzf "${STAGE_DIR}/nginx.tar.gz" -C "${STAGE_DIR}/src" --strip-components=1 && cd "${STAGE_DIR}/src"
./configure --prefix=/etc/nginx --sbin-path=/usr/sbin/nginx --modules-path=/usr/lib/nginx/modules --conf-path=/etc/nginx/nginx.conf --error-log-path=/var/log/nginx/error.log --http-log-path=/var/log/nginx/access.log --pid-path=/run/nginx.pid --lock-path=/run/nginx.lock --user=www-data --group=www-data --with-http_ssl_module --with-http_v2_module --with-http_realip_module --with-http_stub_status_module --with-http_gzip_static_module --with-threads --with-file-aio
/usr/bin/make -j"$(/usr/bin/nproc 2>/dev/null || /bin/echo 2)" && /usr/bin/make install && setup_service
/bin/tar -czf "${STAGE_DIR}/nginx-compiled.tar.gz" /usr/sbin/nginx /etc/nginx $([ -d /usr/lib/nginx ] && /bin/echo /usr/lib/nginx)
s3_cache_push "${STAGE_DIR}/nginx-compiled.tar.gz" "${COMPILED_KEY}"
EOF
Use code with caution.

