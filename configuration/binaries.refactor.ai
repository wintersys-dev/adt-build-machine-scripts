Here are the three complete, POSIX-compliant scripts needed to generate, validate, and migrate your repositories to a central ${BUILD_HOME}/configuration/binaries.dat manifest—formatted strictly to your create_instance.sh template.

1. GenerateBinaryPaths.sh (With Empty-Tool Protection)

Generates ${BUILD_HOME}/configuration/binaries.dat using command -v, strictly fails if any core POSIX binary is missing, and provides a reusable require_bin helper function inside binaries.dat so scripts can validate optional tools (UFW, LINODE_CLI, SENDEMAIL, etc.) in one line before invoking them.
sh
#!/bin/sh
#: Name:        GenerateBinaryPaths.sh
#: Purpose:     Discovers system binary paths and generates ${BUILD_HOME}/configuration/binaries.dat.
#: Author:      Peter Winter
#: Date:        16/11/2026
#: Version:     1.0
#:
#: Usage:       GenerateBinaryPaths.sh
#:              GenerateBinaryPaths.sh [-h|--help]
#:
#: Parameters:
#:   None
#:
#: Environment:
#:   BUILD_HOME Resolved automatically from /home/buildhome.dat
#:
#: Dependencies:
#:   - /home/buildhome.dat
#:   - LogStatusMessages.sh
#:   - External binaries: cat, echo, grep, cut, tr, mv, chmod
#:
#: Exit Codes:
#:   0          binaries.dat generated and validated successfully
#:   1          Missing /home/buildhome.dat, missing mandatory core binary, or write failure
###################################################################################
# License Agreement:
# This file is part of The Wintersys Agile Deployment Toolkit.
# The Agile Deployment Toolkit is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.
# The Agile Deployment Toolkit is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
# You should have received a copy of the GNU General Public License
# along with The Agile Deployment Toolkit.  If not, see <http://gnu.org>.
####################################################################################

# Exit immediately if any command exits with a non-zero status
#set -x
set -e

# Render self-extracting help documentation when -h or --help is supplied
if [ "${1}" = "-h" ] || [ "${1}" = "--help" ]
then
        /usr/bin/grep '^#:' "$0" | /usr/bin/cut -c 4-
        exit 0
fi

# Resolve the toolkit root directory from the system tracking file
if [ -r /home/buildhome.dat ]
then
        BUILD_HOME="$(/bin/cat /home/buildhome.dat)"
else
        /bin/echo "Application root configuration file missing at /home/buildhome.dat" >&2
        exit 1
fi

# Route status log entries to the centralized logging utility
status()
{
        "${BUILD_HOME}/helpers/services/LogStatusMessages.sh" "${1}" 2>/dev/null || true
}

# Restrict PATH strictly to trusted system directories during binary discovery
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

out_file="${BUILD_HOME}/configuration/binaries.dat"
tmp_file="${out_file}.$$"

# Mandatory core tools required across all Wintersys ADT environments
core_tools="awk cat chmod chown cp curl cut date diff echo expr find grep hostname ip jq mkdir mv rm sed sort touch tr uniq wc"

# Optional tools whose presence depends on chosen firewall, email, or cloud provider
optional_tools="aws doctl exo fail2ban-client git ip6tables ip6tables-save ipcalc iptables iptables-save linode-cli mail rclone s3cmd sendemail ssh scp ufw vultr-cli wg wg-quick whois yes"

# Write manifest header and runtime binary guard helper
{
        printf '# Auto-generated by GenerateBinaryPaths.sh — Do not edit manually\n'
        printf '# Provides validated executable paths and require_bin() empty-tool protection.\n\n'
} > "${tmp_file}"

# Discover and enforce mandatory core binaries
for tool in ${core_tools}
do
        var_name="$(printf '%s' "${tool}" | /usr/bin/tr 'a-z-' 'A-Z_')"
        bin_path="$(command -v "${tool}" 2>/dev/null || true)"

        if [ -z "${bin_path}" ] || [ ! -x "${bin_path}" ]
        then
                /bin/rm -f "${tmp_file}"
                status "Error: Mandatory core binary '${tool}' not found or not executable on this system."
                /bin/echo "Error: Mandatory core binary '${tool}' not found or not executable." >&2
                exit 1
        fi

        printf '%s="%s"\n' "${var_name}" "${bin_path}" >> "${tmp_file}"
done

printf '\n# Optional provider and service binaries (may be empty if not installed)\n' >> "${tmp_file}"

# Discover optional binaries (empty string if absent on current host)
for tool in ${optional_tools}
do
        var_name="$(printf '%s' "${tool}" | /usr/bin/tr 'a-z-' 'A-Z_')"
        bin_path="$(command -v "${tool}" 2>/dev/null || true)"

        if [ -n "${bin_path}" ] && [ -x "${bin_path}" ]
        then
                printf '%s="%s"\n' "${var_name}" "${bin_path}" >> "${tmp_file}"
        else
                printf '%s=""\n' "${var_name}" >> "${tmp_file}"
        fi
done

# Append reusable empty-tool guard function for consumer scripts
cat << 'EOF' >> "${tmp_file}"

# Guard helper to verify an optional binary variable is populated and executable
require_bin()
{
        bin_label="${1}"
        bin_target="${2}"

        if [ -z "${bin_target}" ] || [ ! -x "${bin_target}" ]
        then
                /bin/echo "Error: Required tool '${bin_label}' is not installed or not executable on this host." >&2
                return 1
        fi
        return 0
}
EOF

/bin/chmod 644 "${tmp_file}"
/bin/mv "${tmp_file}" "${out_file}"

status "Success! Generated binary path manifest at ${out_file}."

exit 0
Use code with caution.

2. How Scripts Consume binaries.dat Safely (Empty-Tool Protection)

In any script that uses optional tools like UFW, LINODE_CLI, or SENDEMAIL, call require_bin right before using them so an unconfigured tool fails with a clear message instead of executing a blank command:
sh
# Source centralized binary path manifest
if [ -r "${BUILD_HOME}/configuration/binaries.dat" ]
then
        . "${BUILD_HOME}/configuration/binaries.dat"
else
        /bin/echo "Binary path manifest missing at ${BUILD_HOME}/configuration/binaries.dat" >&2
        exit 1
fi

# Example protection for optional tools:
require_bin "ufw" "${UFW}" || exit 1
require_bin "linode-cli" "${LINODE_CLI}" || exit 1
Use code with caution.

3. MigrateBinaryPaths.sh (Repository Migration Script)

Run this script against any repository directory. It supports --dry-run first so you can inspect changes safely, automatically creates .bak backups (or skips backups if --no-backup is passed), injects the . "${BUILD_HOME}/configuration/binaries.dat" sourcing block right after BUILD_HOME is resolved, replaces hardcoded /bin/*, /usr/bin/*, /sbin/*, /usr/sbin/*, and /usr/local/bin/* paths with "${VAR}" references, and validates every modified script with /bin/sh -n.
sh
#!/bin/sh
#: Name:        MigrateBinaryPaths.sh
#: Purpose:     Refactors shell scripts in a target repository to source ${BUILD_HOME}/configuration/binaries.dat.
#: Author:      Peter Winter
#: Date:        16/11/2026
#: Version:     1.0
#:
#: Usage:       MigrateBinaryPaths.sh "<target_repo_dir>" [--dry-run] [--no-backup]
#:              MigrateBinaryPaths.sh [-h|--help]
#:
#: Parameters:
#:   $1         [Required] Path to the target repository directory to migrate
#:   $2         [Optional] "--dry-run" to preview files without modifying them, or "--no-backup"
#:   $3         [Optional] "--no-backup" to skip creating .bak files during live migration
#:
#: Environment:
#:   None
#:
#: Dependencies:
#:   - External binaries: find, grep, cut, sed, awk, cp, mv, rm, tr, sh
#:
#: Exit Codes:
#:   0          Migration completed and all modified scripts passed /bin/sh -n syntax checks
#:   1          Missing target directory, invalid arguments, or syntax validation failure
###################################################################################
# License Agreement:
# This file is part of The Wintersys Agile Deployment Toolkit.
# The Agile Deployment Toolkit is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.
# The Agile Deployment Toolkit is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
# You should have received a copy of the GNU General Public License
# along with The Agile Deployment Toolkit.  If not, see <http://gnu.org>.
####################################################################################

# Exit immediately if any command exits with a non-zero status
#set -x
set -e

# Render self-extracting help documentation when -h or --help is supplied
if [ "${1}" = "-h" ] || [ "${1}" = "--help" ]
then
        /usr/bin/grep '^#:' "$0" | /usr/bin/cut -c 4-
        exit 0
fi

# Validate target repository directory argument
if [ -z "${1}" ] || [ ! -d "${1}" ]
then
        /bin/echo "Error: Valid target repository directory is required." >&2
        /bin/echo "Usage: $0 <target_repo_dir> [--dry-run] [--no-backup]" >&2
        exit 1
fi

target_dir="${1}"
dry_run="0"
create_backup="1"

shift
while [ "$#" -gt 0 ]
do
        case "${1}" in
                --dry-run)
                        dry_run="1"
                        ;;
                --no-backup)
                        create_backup="0"
                        ;;
                *)
                        /bin/echo "Error: Unknown option '${1}'." >&2
                        exit 1
                        ;;
        esac
        shift
done

# Build sed transformation rules for all standard binary paths
sed_script="/tmp/migrate_bins.$$.sed"
trap '/bin/rm -f "${sed_script}"' EXIT

tools="awk cat chmod chown cp curl cut date diff echo expr find grep hostname ip ip6tables ip6tables-save ipcalc iptables iptables-save jq linode-cli mail mkdir mv rclone rm s3cmd sed sendemail sort touch tr ufw uniq vultr-cli wc wg wg-quick whois yes"

: > "${sed_script}"
for tool in ${tools}
do
        var_name="$(printf '%s' "${tool}" | /usr/bin/tr 'a-z-' 'A-Z_')"
        # Skip comments (^) and replace hardcoded /bin/, /usr/bin/, /sbin/, /usr/sbin/, /usr/local/bin/ paths
        printf '/^[[:space:]]*#/! s|\\(/usr/local/sbin\\|/usr/local/bin\\|/usr/sbin\\|/usr/bin\\|/sbin\\|/bin\\)/%s\\([[:space:]"'\'';|)&]\\|$\\)|"${%s}"\\2|g\n' "${tool}" "${var_name}" >> "${sed_script}"
done

# Find all POSIX /bin/sh scripts excluding .git and GenerateBinaryPaths.sh itself
script_list="/tmp/migrate_files.$$.list"
trap '/bin/rm -f "${sed_script}" "${script_list}"' EXIT

/usr/bin/find "${target_dir}" -path '*/.git' -prune -o -type f -name '*.sh' -print > "${script_list}"

migrated_count="0"
error_count="0"

while IFS= read -r script_file
do
        base_name="${script_file##*/}"
        if [ "${base_name}" = "GenerateBinaryPaths.sh" ] || [ "${base_name}" = "MigrateBinaryPaths.sh" ]
        then
                continue
        fi

        # Verify file starts with #!/bin/sh
        first_line="$(/usr/bin/head -n 1 "${script_file}")"
        if [ "${first_line}" != "#!/bin/sh" ]
        then
                continue
        fi

        tmp_out="${script_file}.migrating.$$"

        # Step 1: Replace hardcoded binary paths with "${VAR}"
        /bin/sed -f "${sed_script}" "${script_file}" > "${tmp_out}"

        # Step 2: Restore literal /bin/cat and /bin/echo inside the initial BUILD_HOME bootstrap block
        # and inject the binaries.dat sourcing block right after BUILD_HOME is resolved
        if ! /usr/bin/grep -q 'configuration/binaries\.dat' "${tmp_out}" && /usr/bin/grep -q 'BUILD_HOME=' "${tmp_out}"
        then
                tmp_injected="${script_file}.injected.$$"
                /usr/bin/awk '
                BEGIN { in_bootstrap = 0; injected = 0 }
                {
                        if (!injected && $0 ~ /BUILD_HOME=/) {
                                in_bootstrap = 1
                        }
                        if (in_bootstrap) {
                                gsub(/"\$\{CAT\}"/, "/bin/cat")
                                gsub(/"\$\{ECHO\}"/, "/bin/echo")
                        }
                        print $0
                        if (in_bootstrap && $0 ~ /^fi[[:space:]]*$/) {
                                in_bootstrap = 0
                                injected = 1
                                print ""
                                print "# Source centralized binary path manifest"
                                print "if [ -r \"${BUILD_HOME}/configuration/binaries.dat\" ]"
                                print "then"
                                print "        . \"${BUILD_HOME}/configuration/binaries.dat\""
                                print "else"
                                print "        /bin/echo \"Binary path manifest missing at ${BUILD_HOME}/configuration/binaries.dat\" >&2"
                                print "        exit 1"
                                print "fi"
                        }
                }' "${tmp_out}" > "${tmp_injected}"
                /bin/mv "${tmp_injected}" "${tmp_out}"
        fi

        # Check whether any changes were actually produced
        if /usr/bin/diff -q "${script_file}" "${tmp_out}" >/dev/null 2>&1
        then
                /bin/rm -f "${tmp_out}"
                continue
        fi

        if [ "${dry_run}" = "1" ]
        then
                /bin/echo "[DRY-RUN] Would migrate: ${script_file}"
                /bin/rm -f "${tmp_out}"
                migrated_count="$((migrated_count + 1))"
                continue
        fi

        # Validate POSIX shell syntax before overwriting original file
        if ! /bin/sh -n "${tmp_out}"
        then
                /bin/echo "Error: Syntax validation failed after migrating ${script_file}; leaving original untouched." >&2
                /bin/rm -f "${tmp_out}"
                error_count="$((error_count + 1))"
                continue
        fi

        if [ "${create_backup}" = "1" ]
        then
                /bin/cp -p "${script_file}" "${script_file}.bak"
        fi

        # Preserve executable permissions on the migrated file
        /bin/chmod --reference="${script_file}" "${tmp_out}" 2>/dev/null || /bin/chmod 755 "${tmp_out}"
        /bin/mv "${tmp_out}" "${script_file}"
        /bin/echo "Migrated: ${script_file}"
        migrated_count="$((migrated_count + 1))"

done < "${script_list}"

/bin/echo "Summary: ${migrated_count} script(s) processed, ${error_count} error(s)."

if [ "${error_count}" -ne 0 ]
then
        exit 1
fi

exit 0
Use code with caution.

Recommended Rollout Workflow

1. Run GenerateBinaryPaths.sh once during Build Machine initialization so ${BUILD_HOME}/configuration/binaries.dat is created and verified.
2. Preview changes on a repository with:sh
./MigrateBinaryPaths.sh /path/to/repo --dry-run
Use code with caution.
3. Run the live migration (which creates .bak files and runs /bin/sh -n on every modified script), inspect git diff, and remove .bak files once satisfied:sh
./MigrateBinaryPaths.sh /path/to/repo
git diff
find /path/to/repo -name '*.bak' -delete
Use code with caution.
Would you like me to use "${GREP}", "${JQ}", "${CURL}", and require_bin from binaries.dat in all subsequent scripts you ask me to refactor in this session?
