4. Standalone Engine (pkgbox.sh)

sh
#!/bin/sh
set -eu

BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROFILE="${BASE_DIR}/profile.env"
MANIFEST="${BASE_DIR}/manifest.conf"
STATE_DIR="/var/lib/pkgbox/done"

DRY_RUN=0
ONLY_TARGET=""
RESET_TARGET=""

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run|-n)
            DRY_RUN=1
            shift
            ;;
        --only)
            ONLY_TARGET="${2:-}"
            [ -n "${ONLY_TARGET}" ] || { printf 'Error: --only requires a target name\n' >&2; exit 1; }
            shift 2
            ;;
        --only=*)
            ONLY_TARGET="${1#--only=}"
            shift
            ;;
        --reset)
            RESET_TARGET="${2:-}"
            [ -n "${RESET_TARGET}" ] || { printf 'Error: --reset requires a target name or "all"\n' >&2; exit 1; }
            shift 2
            ;;
        --reset=*)
            RESET_TARGET="${1#--reset=}"
            shift
            ;;
        *)
            printf 'Usage: %s [--dry-run] [--only <name>] [--reset <name|all>]\n' "$0" >&2
            exit 1
            ;;
    esac
done

mkdir -p "${STATE_DIR}"

if [ -n "${RESET_TARGET}" ]; then
    if [ "${RESET_TARGET}" = "all" ]; then
        rm -f "${STATE_DIR}"/*
        printf 'Cleared all local state markers in %s\n' "${STATE_DIR}"
    else
        rm -f "${STATE_DIR}/${RESET_TARGET}"
        printf 'Cleared state marker for %s\n' "${RESET_TARGET}"
    fi
    [ -z "${ONLY_TARGET}" ] && exit 0
fi

[ -f "${PROFILE}" ] && . "${PROFILE}"

. /etc/os-release
RAW_ARCH="$(uname -m)"
case "${RAW_ARCH}" in
    x86_64)  ARCH="amd64" ;;
    aarch64) ARCH="arm64" ;;
    *)       ARCH="${RAW_ARCH}" ;;
esac

OS_KEY="${ID}-${VERSION_ID}-${ARCH}"
CACHE_URI="${S3_CACHE_BUCKET:-}/${OS_KEY}"

WORK_DIR="$(mktemp -d /tmp/pkgbox.XXXXXX)"
trap 'rm -rf "${WORK_DIR}"' EXIT INT TERM

log() { printf '[%s] [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" "$2"; }

s3_cp() {
    src="$1"; dst="$2"
    if command -v s5cmd >/dev/null 2>&1; then
        if [ -n "${S3_ENDPOINT_URL:-}" ]; then
            s5cmd --endpoint-url "${S3_ENDPOINT_URL}" cp "$src" "$dst" >/dev/null 2>&1
        else
            s5cmd cp "$src" "$dst" >/dev/null 2>&1
        fi
    elif command -v rclone >/dev/null 2>&1; then
        if [ -n "${S3_ENDPOINT_URL:-}" ]; then
            rclone --s3-endpoint "${S3_ENDPOINT_URL}" copyto "$src" "$dst" >/dev/null 2>&1
        else
            rclone copyto "$src" "$dst" >/dev/null 2>&1
        fi
    else
        return 1
    fi
}

cache_get() {
    key="$1"; dest="$2"
    [ -z "${S3_CACHE_BUCKET:-}" ] && return 1
    rm -f "${dest}" "${dest}.sha256"

    s3_cp "${CACHE_URI}/${key}" "${dest}" || return 1
    s3_cp "${CACHE_URI}/${key}.sha256" "${dest}.sha256" || return 1

    expected="$(awk '{print $1}' "${dest}.sha256")"
    actual="$(sha256sum "${dest}" | awk '{print $1}')"
    if [ -n "${expected}" ] && [ "${expected}" = "${actual}" ]; then
        rm -f "${dest}.sha256"
        log "CACHE" "HIT: ${key}"
        return 0
    fi
    log "WARN" "CACHE" "CORRUPT: ${key} failed SHA-256 check"
    rm -f "${dest}" "${dest}.sha256"
    return 1
}

cache_put() {
    src="$1"; key="$2"
    [ -z "${S3_CACHE_BUCKET:-}" ] || [ ! -s "${src}" ] && return 0
    sha256sum "${src}" | awk '{print $1}' > "${src}.sha256"
    if s3_cp "${src}" "${CACHE_URI}/${key}" && s3_cp "${src}.sha256" "${CACHE_URI}/${key}.sha256"; then
        log "CACHE" "PUSH: ${key}"
    fi
    rm -f "${src}.sha256"
}

run_apt() {
    name="$1"; pkgs="$2"
    deb_dir="${WORK_DIR}/${name}_debs"
    tar_path="${WORK_DIR}/${name}.tar.gz"
    mkdir -p "${deb_dir}/partial"
    export DEBIAN_FRONTEND=noninteractive

    if cache_get "${name}.tar.gz" "${tar_path}"; then
        tar -xzf "${tar_path}" -C "${deb_dir}"
        apt-get -o DPkg::Lock::Timeout=-1 -o "Dir::Cache::Archives=${deb_dir}" -qq -y install --no-download ${pkgs} || \
        apt-get -o DPkg::Lock::Timeout=-1 -o "Dir::Cache::Archives=${deb_dir}" -qq -y install ${pkgs}
        return 0
    fi

    apt-get -o DPkg::Lock::Timeout=-1 -qq -y update
    apt-get -o DPkg::Lock::Timeout=-1 -o "Dir::Cache::Archives=${deb_dir}" -qq -y install --download-only --reinstall ${pkgs}
    apt-get -o DPkg::Lock::Timeout=-1 -o "Dir::Cache::Archives=${deb_dir}" -qq -y install ${pkgs}

    if ls "${deb_dir}"/*.deb >/dev/null 2>&1; then
        tar -czf "${tar_path}" -C "${deb_dir}" .
        cache_put "${tar_path}" "${name}.tar.gz"
    fi
}

grep -vE '^[[:space:]]*#|^[[:space:]]*$' "${MANIFEST}" | while IFS='|' read -r r_name r_flag r_type r_target
do
    name="$(echo "$r_name" | xargs)"
    flag="$(echo "$r_flag" | xargs)"
    type="$(echo "$r_type" | xargs)"
    target="$(echo "$r_target" | xargs)"

    if [ -n "${ONLY_TARGET}" ] && [ "${name}" != "${ONLY_TARGET}" ]; then
        continue
    fi

    if [ -z "${ONLY_TARGET}" ] && [ -f "${STATE_DIR}/${name}" ]; then
        continue
    fi

    if [ -z "${ONLY_TARGET}" ] && [ "${flag}" != "ALWAYS" ]; then
        case "${flag}" in *[!A-Z0-9_]*) log "ERROR" "Invalid flag name: ${flag}"; exit 1 ;; esac
        flag_val="$(eval "printf '%s' \"\${${flag}:-0}\"")"
        [ "${flag_val}" = "1" ] || continue
    fi

    if [ "${DRY_RUN}" -eq 1 ]; then
        printf '[DRY-RUN] %-14s | Type: %-6s | Target: %s\n' "${name}" "${type}" "${target}"
        continue
    fi

    log "INFO" "Installing ${name}..."
    for attempt in 1 2 3; do
        rc=0
        case "${type}" in
            "apt")
                run_apt "${name}" "${target}" || rc=$?
                ;;
            "recipe")
                ( set -e; . "${BASE_DIR}/recipes/${target}" ) || rc=$?
                ;;
            *)
                log "ERROR" "Unknown type: ${type}"; exit 1
                ;;
        esac

        if [ "${rc}" -eq 0 ]; then
            touch "${STATE_DIR}/${name}"
            break
        fi
        log "WARN" "Retry ${attempt}/3 for ${name} (rc=${rc})..."
        sleep 2
    done

    if [ ! -f "${STATE_DIR}/${name}" ]; then
        log "ERROR" "Failed to install ${name}"
        exit 1
    fi
    log "OK" "${name} installed."
done
