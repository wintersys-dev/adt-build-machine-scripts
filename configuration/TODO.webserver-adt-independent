4. pkgbox.sh — Block 1: CLI Parsing (--profile, --status, --dry-run, --only, --reset, --cache-*)

sh
#!/bin/sh
set -eu

BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROFILE="${BASE_DIR}/profiles/default.env"
MANIFEST="${BASE_DIR}/manifest.conf"
STATE_DIR="/var/lib/pkgbox/done"
LOCK_DIR="/var/lock/pkgbox.lock"

DRY_RUN=0
STATUS_MODE=0
CACHE_LIST=0
CACHE_PURGE=""
ONLY_TARGET=""
RESET_TARGET=""

while [ $# -gt 0 ]; do
    case "$1" in
        --profile|-p)
            PROFILE="${2:-}"
            [ -n "${PROFILE}" ] || { printf 'Error: --profile requires a file path\n' >&2; exit 1; }
            shift 2
            ;;
        --profile=*)
            PROFILE="${1#--profile=}"
            shift
            ;;
        --dry-run|-n)
            DRY_RUN=1
            shift
            ;;
        --status|-s)
            STATUS_MODE=1
            shift
            ;;
        --cache-list)
            CACHE_LIST=1
            shift
            ;;
        --cache-purge)
            CACHE_PURGE="${2:-}"
            [ -n "${CACHE_PURGE}" ] || { printf 'Error: --cache-purge requires a prefix or "all"\n' >&2; exit 1; }
            shift 2
            ;;
        --cache-purge=*)
            CACHE_PURGE="${1#--cache-purge=}"
            shift
            ;;
        --only)
            ONLY_TARGET="${2:-}"
            [ -n "${ONLY_TARGET}" ] || { printf 'Error: --only requires a target name\n' >&2; exit 1; }
            shift 2
            ;;
        --only=*)
            ONLY_TARGET="${1#--only=}"
            shift
            ;;
        --reset)
            RESET_TARGET="${2:-}"
            [ -n "${RESET_TARGET}" ] || { printf 'Error: --reset requires a target name or "all"\n' >&2; exit 1; }
            shift 2
            ;;
        --reset=*)
            RESET_TARGET="${1#--reset=}"
            shift
            ;;
        *)
            printf 'Usage: %s [--profile <file>] [--status] [--dry-run] [--only <name>] [--reset <name|all>] [--cache-list] [--cache-purge <prefix|all>]\n' "$0" >&2
            exit 1
            ;;
    esac
done

# Allow shorthand profile names like '--profile db' -> 'profiles/db.env'
if [ ! -f "${PROFILE}" ] && [ -f "${BASE_DIR}/profiles/${PROFILE}.env" ]; then
    PROFILE="${BASE_DIR}/profiles/${PROFILE}.env"
fi

[ -f "${PROFILE}" ] || { printf 'Error: Profile not found: %s\n' "${PROFILE}" >&2; exit 1; }
Use code with caution.

5. pkgbox.sh — Block 2: Environment, S3 Helpers & Cache Primitives (Append to pkgbox.sh)

sh
mkdir -p "${STATE_DIR}" /var/lock

if [ -n "${RESET_TARGET}" ]; then
    if [ "${RESET_TARGET}" = "all" ]; then
        rm -f "${STATE_DIR}"/*
        printf 'Cleared all local state hashes in %s\n' "${STATE_DIR}"
    else
        rm -f "${STATE_DIR}/${RESET_TARGET}"
        printf 'Cleared state hash for %s\n' "${RESET_TARGET}"
    fi
    [ -z "${ONLY_TARGET}" ] && exit 0
fi

. "${PROFILE}"

. /etc/os-release
RAW_ARCH="$(uname -m)"
case "${RAW_ARCH}" in
    x86_64)  ARCH="amd64" ;;
    aarch64) ARCH="arm64" ;;
    *)       ARCH="${RAW_ARCH}" ;;
esac

OS_KEY="${ID}-${VERSION_ID}-${ARCH}"
CACHE_URI="${S3_CACHE_BUCKET:-}/${OS_KEY}"
PROFILE_CONTENT="$(cat "${PROFILE}")"

log() { printf '[%s] [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" "$2"; }

s3_cp() {
    src="$1"; dst="$2"
    if command -v s5cmd >/dev/null 2>&1; then
        if [ -n "${S3_ENDPOINT_URL:-}" ]; then
            s5cmd --endpoint-url "${S3_ENDPOINT_URL}" cp "$src" "$dst" >/dev/null 2>&1
        else
            s5cmd cp "$src" "$dst" >/dev/null 2>&1
        fi
    elif command -v rclone >/dev/null 2>&1; then
        if [ -n "${S3_ENDPOINT_URL:-}" ]; then
            rclone --s3-endpoint "${S3_ENDPOINT_URL}" copyto "$src" "$dst" >/dev/null 2>&1
        else
            rclone copyto "$src" "$dst" >/dev/null 2>&1
        fi
    else
        return 1
    fi
}

s3_ls() {
    [ -n "${S3_CACHE_BUCKET:-}" ] || { printf 'Error: S3_CACHE_BUCKET is not set in %s\n' "${PROFILE}" >&2; exit 1; }
    printf 'S3 Cache Contents (%s):\n' "${CACHE_URI}/"
    if command -v s5cmd >/dev/null 2>&1; then
        [ -n "${S3_ENDPOINT_URL:-}" ] && s5cmd --endpoint-url "${S3_ENDPOINT_URL}" ls "${CACHE_URI}/*" || s5cmd ls "${CACHE_URI}/*" || true
    elif command -v rclone >/dev/null 2>&1; then
        [ -n "${S3_ENDPOINT_URL:-}" ] && rclone --s3-endpoint "${S3_ENDPOINT_URL}" ls "${CACHE_URI}/" || rclone ls "${CACHE_URI}/" || true
    else
        printf 'Error: Neither s5cmd nor rclone is installed.\n' >&2; exit 1
    fi
}

s3_rm() {
    [ -n "${S3_CACHE_BUCKET:-}" ] || { printf 'Error: S3_CACHE_BUCKET is not set in %s\n' "${PROFILE}" >&2; exit 1; }
    pattern="*"
    [ "$1" != "all" ] && pattern="${1}*"
    printf 'Purging S3 cache matching %s/%s ...\n' "${CACHE_URI}" "${pattern}"
    if command -v s5cmd >/dev/null 2>&1; then
        [ -n "${S3_ENDPOINT_URL:-}" ] && s5cmd --endpoint-url "${S3_ENDPOINT_URL}" rm "${CACHE_URI}/${pattern}" || s5cmd rm "${CACHE_URI}/${pattern}" || true
    elif command -v rclone >/dev/null 2>&1; then
        [ -n "${S3_ENDPOINT_URL:-}" ] && rclone --s3-endpoint "${S3_ENDPOINT_URL}" delete "${CACHE_URI}/" --include "${pattern}" || rclone delete "${CACHE_URI}/" --include "${pattern}" || true
    else
        printf 'Error: Neither s5cmd nor rclone is installed.\n' >&2; exit 1
    fi
}

[ "${CACHE_LIST}" -eq 1 ] && { s3_ls; exit 0; }
[ -n "${CACHE_PURGE}" ] && { s3_rm "${CACHE_PURGE}"; exit 0; }

if [ "${DRY_RUN}" -eq 0 ] && [ "${STATUS_MODE}" -eq 0 ]; then
    if ! mkdir "${LOCK_DIR}" 2>/dev/null; then
        printf 'Error: Another pkgbox instance is currently running (%s exists).\n' "${LOCK_DIR}" >&2
        exit 1
    fi
fi

WORK_DIR="$(mktemp -d /tmp/pkgbox.XXXXXX)"
trap 'rm -rf "${WORK_DIR}" "${LOCK_DIR}"' EXIT INT TERM

cache_get() {
    key="$1"; dest="$2"
    [ -z "${S3_CACHE_BUCKET:-}" ] && return 1
    rm -f "${dest}" "${dest}.sha256"

    s3_cp "${CACHE_URI}/${key}" "${dest}" || return 1
    s3_cp "${CACHE_URI}/${key}.sha256" "${dest}.sha256" || return 1

    expected="$(awk '{print $1}' "${dest}.sha256")"
    actual="$(sha256sum "${dest}" | awk '{print $1}')"
    if [ -n "${expected}" ] && [ "${expected}" = "${actual}" ]; then
        rm -f "${dest}.sha256"
        log "CACHE" "HIT: ${key}"
        return 0
    fi
    log "WARN" "CACHE" "CORRUPT: ${key} failed SHA-256 check"
    rm -f "${dest}" "${dest}.sha256"
    return 1
}

cache_put() {
    src="$1"; key="$2"
    [ -z "${S3_CACHE_BUCKET:-}" ] || [ ! -s "${src}" ] && return 0
    sha256sum "${src}" | awk '{print $1}' > "${src}.sha256"
    if s3_cp "${src}" "${CACHE_URI}/${key}" && s3_cp "${src}.sha256" "${CACHE_URI}/${key}.sha256"; then
        log "CACHE" "PUSH: ${key}"
    fi
    rm -f "${src}.sha256"
}
