Part 3: Custom PHP Repo Script (setup-php-repo.sh)

sh
#!/bin/sh
set -eu

DISTRO=$(. /etc/os-release && printf '%s' "${ID}")
CODE=$(/usr/bin/lsb_release -cs)
KEYRING="/etc/apt/keyrings"

/bin/mkdir -p "${KEYRING}"

case "${DISTRO}" in
    ubuntu)
        KEY_URL="https://ubuntu.com"
        KEY_ID="0x14AA40EC0831756756D7F66C4F4EA0AAE5267A6C"
        PPA="https://launchpadcontent.net"
        /usr/bin/wget -qO- "${KEY_URL}?op=get&search=${KEY_ID}" \
            | /usr/bin/gpg --batch --yes --dearmor \
            -o "${KEYRING}/ondrej-php.gpg"
        printf '%s\n' \
            "deb [signed-by=${KEYRING}/ondrej-php.gpg] ${PPA} ${CODE} main" \
            > /etc/apt/sources.list.d/ondrej-php.list
        ;;
    debian)
        SURY="https://sury.org"
        /usr/bin/wget -qO "${KEYRING}/sury-php.gpg" \
            "${SURY}/apt.gpg"
        printf '%s\n' \
            "deb [signed-by=${KEYRING}/sury-php.gpg] ${SURY}/ ${CODE} main" \
            > /etc/apt/sources.list.d/sury-php.list
        ;;
    *)
        printf '%s\n' "Unsupported distro: ${DISTRO}" >&2
        exit 1
        ;;
esac
