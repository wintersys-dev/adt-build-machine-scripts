2. Updated POSIX Runner (ApplySoftwareCacheManifest.sh)

Pass the calling script's filename (via $(basename "$0")) or a role name as the second argument. If omitted, it automatically detects the parent script name using ps.
sh
#!/bin/sh
# POSIX Manifest Executor with File/Role Filtering
set -eu

if [ -r /home/homedir.dat ]; then
    HOME="$(/bin/cat /home/homedir.dat)"
else
    /bin/echo "Missing /home/homedir.dat" >&2
    exit 1
fi

MANIFEST="${1:-${HOME}/runtime/software-cache.dat}"
# Second arg: explicit filter (e.g. "webserver" or "BuildWebserver.sh")
# Defaults to 'all' if run interactively without a filter
FILTER="${2:-all}"

INST="${HOME}/providerscripts/utilities/InstallWithS3Cache.sh"
PDIR="${HOME}/providerscripts"

if [ ! -r "${MANIFEST}" ]; then
    printf '%s\n' "ERROR: Manifest not readable: ${MANIFEST}" >&2
    exit 1
fi

if [ ! -x "${INST}" ]; then
    printf '%s\n' "ERROR: Installer not executable: ${INST}" >&2
    exit 1
fi

matches_filter() {
    line_targets="$1"
    active_filter="$2"

    # Strip '.sh' extension if a filename was passed (e.g. BuildWebserver.sh -> BuildWebserver)
    norm_filter=$(printf '%s' "${active_filter}" | /bin/sed 's/\.sh$//')

    # If runner was called with 'all' or manifest line says 'all', allow it
    [ "${norm_filter}" = "all" ] && return 0
    [ -z "${line_targets}" ] || [ "${line_targets}" = "all" ] && return 0

    # Check comma-separated list in manifest
    old_ifs="${IFS}"
    IFS=','
    for item in ${line_targets}; do
        norm_item=$(printf '%s' "${item}" | /bin/sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/\.sh$//')
        if [ "${norm_item}" = "all" ] || [ "${norm_item}" = "${norm_filter}" ]; then
            IFS="${old_ifs}"
            return 0
        fi
    done
    IFS="${old_ifs}"
    return 1
}

while IFS= read -r line || [ -n "${line}" ]; do
    clean=$(printf '%s' "${line}" | /bin/sed 's/^[[:space:]]*//')
    case "${clean}" in
        ""|\#*) continue ;;
    esac

    header=$(printf '%s' "${clean}" | /usr/bin/cut -d'|' -f1)
    target=$(printf '%s' "${clean}" | /usr/bin/cut -d'|' -f2)
    extra=$(printf '%s' "${clean}" | /usr/bin/cut -d'|' -f3)
    install_dir=$(printf '%s' "${clean}" | /usr/bin/cut -d'|' -f4)
    sha256=$(printf '%s' "${clean}" | /usr/bin/cut -d'|' -f5)
    targets=$(printf '%s' "${clean}" | /usr/bin/cut -d'|' -f6)

    # Skip line if it does not match the requested file or role
    if ! matches_filter "${targets}" "${FILTER}"; then
        continue
    fi

    name=$(printf '%s' "${header}" | /usr/bin/cut -d':' -f1)
    mode=$(printf '%s' "${header}" | /usr/bin/cut -d':' -f2)
    version=$(printf '%s' "${header}" | /usr/bin/cut -d':' -f3)

    if [ -z "${name}" ] || [ -z "${mode}" ] || [ -z "${version}" ] \
        || [ -z "${target}" ]; then
        printf '%s\n' "ERROR: Malformed manifest line: ${clean}" >&2
        exit 1
    fi

    case "${extra}" in
        @/*)
            extra="${PDIR}/$(printf '%s' "${extra}" | /usr/bin/cut -c3-)"
            ;;
        hold:@/*)
            rest=$(printf '%s' "${extra}" | /usr/bin/cut -c8-)
            extra="hold:${PDIR}/${rest}"
            ;;
        hold-pinned:@/*)
            rest=$(printf '%s' "${extra}" | /usr/bin/cut -c15-)
            extra="hold-pinned:${PDIR}/${rest}"
            ;;
    esac

    [ -z "${install_dir}" ] && install_dir="/usr/local/bin"

    printf '%s\n' "==> [${FILTER}] Processing ${name} (${mode} v${version})"
    "${INST}" "${mode}" "${name}" "${version}" \
        "${target}" "${extra}" "${install_dir}" "${sha256}"

done < "${MANIFEST}"
