2. Custom Source Build Script Example (build-nginx-custom.sh)

sh
#!/bin/sh
set -eu

# Provided automatically by InstallWithS3Cache.sh:
#   STAGE_DIR : Staging root directory (use DESTDIR="${STAGE_DIR}" on make install)
#   SRC_DIR   : Unpacked source directory (current working directory)
#   NAME      : Software name
#   VERSION   : Software version
#   $@        : Custom build options passed after the script path

printf '%s\n' "Building ${NAME} ${VERSION} with custom options: $*"

./configure \
    --prefix=/usr/local/nginx \
    --sbin-path=/usr/sbin/nginx \
    --conf-path=/etc/nginx/nginx.conf \
    --with-http_ssl_module \
    --with-http_v2_module \
    --with-http_realip_module \
    "$@"

/usr/bin/make -j"$(/usr/bin/nproc)"
/usr/bin/make DESTDIR="${STAGE_DIR}" install
